---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericProps } from '../../ts/types/index.ts';

import type { ContentType, PageProps } from '../../astro/layouts.js';

/* import - functions */
import { arrayUnique, mergeArgs } from '@maddimathon/utility-typescript';

import { absoluteInternalURL } from '../../astro/functions.js';

/* import - values */
import { PRIMARY_MENU, SITE_TITLE } from '../constants.js';

/* import - components */

/* import - layouts */
import LibPage from '../../astro/layouts/Page.astro';

/* PROPS ===================================== */

type Partial_LibProps = Partial<PageProps<ContentType>>;

type Props = GenericProps<Partial_LibProps>;

const _defaultProps = {
    title: SITE_TITLE,

    dir: 'ltr',
    lang: 'en-CA',

    footer: {
        copyright: {
            html:
                'by <a href="https://www.maddimathon.com/web" target="_blank">Maddi Mathon</a>' +
                ' | ' +
                '<a href="' +
                absoluteInternalURL(Astro.url, 'license') +
                '">MIT license</a>' +
                ' | ' +
                'Human-built without the use of generative AI.',

            year: 2025,
        },
    },

    meta: {
        title: SITE_TITLE,
    },

    // settings: false,
    settings: {
        settings: {
            brightness: true,
            contrast: true,
            motion: true,
        },
    },
} as const satisfies Props & PageProps<ContentType>;

const props: PageProps = mergeArgs(
    _defaultProps,
    Astro.props.frontmatter ?? Astro.props,
    true,
);

/* CONSTANTS ===================================== */

const title = Array.isArray(props.title) ? props.title : [props.title];

if (!props.meta.title) {
    props.meta.title = arrayUnique(
        title.concat([_defaultProps.meta.title]),
    ).join(' — ');
}

props.primaryMenu = PRIMARY_MENU();

const fullProps = {
    ...props,
    accessibilityReportEmail: undefined,
    layout: props.layout || 'content-only',
    title,
} satisfies PageProps;

const stylesheetHref = absoluteInternalURL(Astro.url, 'assets/css/main.css');
---

<LibPage {...fullProps}>
    <link
        slot='head-open'
        rel='preload'
        href={stylesheetHref}
        as='style'
    />
    <link
        slot='head-open'
        rel='stylesheet'
        href={stylesheetHref}
    />

    <slot
        slot='head-open'
        name='head-open'
    />

    <slot
        slot='head-close'
        name='head-close'
    />

    <meta
        slot='head-close'
        name='color-scheme'
        content='dark light'
    />

    <slot
        slot='body-open'
        name='body-open'
    />

    <slot
        name='settings-menu-open'
        slot='settings-menu-open'
    />
    <p
        slot='settings-menu-open'
        class='website-settings__disclaimer'
    >
        These settings are saved using browser cookies.
    </p>

    <slot
        name='settings-menu'
        slot='settings-menu'
    />
    <slot
        name='settings-menu-close'
        slot='settings-menu-close'
    />

    <slot
        slot='before-header'
        name='before-header'
    />

    <slot
        slot='header'
        name='header'
    />

    <slot
        slot='before-primary-nav'
        name='before-primary-nav'
    />

    <slot
        slot='after-primary-nav'
        name='after-primary-nav'
    />

    <slot
        slot='after-header'
        name='after-header'
    />

    <slot
        slot='content-header'
        name='content-header'
    />
    <slot
        slot='before-main-content'
        name='before-main-content'
    />
    <slot />
    <slot
        slot='after-main-content'
        name='after-main-content'
    />

    <slot
        slot='sidebar'
        name='sidebar'
    />

    <slot
        slot='before-secondary-nav'
        name='before-secondary-nav'
    />

    <slot
        slot='after-secondary-nav'
        name='after-secondary-nav'
    />

    <slot
        slot='before-footer'
        name='before-footer'
    />

    <slot
        slot='footer'
        name='footer'
    />

    <slot
        slot='after-footer'
        name='after-footer'
    />

    <slot
        slot='body-close'
        name='body-close'
    />

    <slot
        slot='footer-scripts'
        name='footer-scripts'
    />
</LibPage>
