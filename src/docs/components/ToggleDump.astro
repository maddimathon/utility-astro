---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../ts/types/index.js';
import type {
    CodeBlockProps,
    CodeBlockComponentType,
} from '../../astro/components/CodeBlock.astro';
import type { ToggleComponentType } from '../../astro/components/Toggle.astro';

/* import - functions */
import { slugify } from '@maddimathon/utility-typescript';

/* import - values */

/* import - components */
import CodeBlockComponent from '../../astro/components/CodeBlock.astro';
import ToggleComponent from '../../astro/components/Toggle.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export type Props_Inner = {
    title: string;

    code?: string;

    components?: Partial<{
        CodeBlock: CodeBlockComponentType;
        Toggle: ToggleComponentType;
    }>;

    heading?: number;
    lang?: Required<CodeBlockProps>['lang'];

    /**
     * @since 0.1.0-beta.0
     */
    toggleProps?: {};
};

export interface Props extends ElementProps<Props_Inner, 'div'> {}

const {
    lang,
    code,
    heading = 2,
    title,
    components: {
        CodeBlock = CodeBlockComponent,
        Toggle = ToggleComponent,
    } = {},
    toggleProps = {},
} = Astro.props;

/* CONSTANTS ===================================== */

const html: string = (await Astro.slots.render('default'))?.trim();

const id = slugify(`toggle-dump-${title}`);
---

<Toggle
    {...toggleProps}
    heading={heading}
    id={id}
>
    <Fragment
        slot='button'
        set:text={title}
    />
    {
        code ? (
            <CodeBlock
                lang={lang}
                set:html={code.trim()}
            />
        ) : (
            <Fragment set:html={html.trim()} />
        )
    }
</Toggle>
