---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    GenericElementProps,
    PropsOptionalChildren,
} from '../../ts/types/index.js';

import type { CopyToClipboardButtonProps } from './CopyToClipboardButton.astro';

/* import - functions */
import { flattenClassList } from '../functions.js';

/* import - values */

/* import - components */
import { Prism } from '@astrojs/prism';
import CopyToClipboardButton from './CopyToClipboardButton.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

/**
 * Input props for the CodeBlock component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export type CodeBlockProps = GenericElementProps<
    PropsOptionalChildren<{
        copyToClipboard?: boolean | CopyToClipboardButtonProps | undefined;

        /**
         * Code language, if any.
         */
        lang?: string | undefined;
    }>,
    'div'
>;

type Props = CodeBlockProps;

/**
 * @since 0.1.0-beta.3
 */
export type CodeBlockComponentType = (props: CodeBlockProps) => any;

const {
    copyToClipboard = false,
    lang,
    class: classList = [],
    ...attributes
} = Astro.props.frontmatter ?? Astro.props;

/* CONSTANTS ===================================== */

const codeHTML =
    (await Astro.slots.render('default'))?.replace(/^[\n\s]+|[\n\s]+$/gi, '') ??
    '';
---

{
    codeHTML &&
        (lang ? (
            <Prism
                {...attributes}
                code={codeHTML}
                lang={lang}
                class:list={classList ?? []}
            />
        ) : (
            <pre
                {...attributes}
                class={flattenClassList(classList)}
            >
                <code set:text={codeHTML} />
            </pre>
        ))
}
{
    copyToClipboard && (
        <CopyToClipboardButton
            toClipboard={codeHTML}
            successMessage='copied!'
            {...(typeof copyToClipboard === 'object' ? copyToClipboard : {})}
            set:text='copy'
            class:list='button--inline button--copy-code'
        />
    )
}
