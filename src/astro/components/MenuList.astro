---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type { Classify } from '@maddimathon/utility-typescript/types';

import type { ClassList, ElementProps } from '../../ts/types/index.js';

import type { DynamicWrapperComponentType } from './DynamicWrapper.astro';

/* import - functions */
import { absoluteInternalURL, makeClassList } from '../functions.js';

/* import - values */
import { SUBMENU_HAS_WRAPPER } from 'astro:env/client';

import DynamicWrapper from './DynamicWrapper.astro';

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

export type BaseMenuItem =
    | {
          /**
           * Display text for this link item.
           */
          label: string;
          labelHTML?: undefined;
      }
    | {
          label?: undefined;
          /**
           * Display HTML for this link item.
           */
          labelHTML: string;
      };

/**
 * A single menu item for the MenuList component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export type MenuItem = BaseMenuItem & {
    /**
     * @since 0.1.0-beta.6
     */
    attrs?:
        ElementProps<{}, 'a', 'aria-current' | 'class' | 'href'> | undefined;

    /**
     * If false, the link prints without href and with aria-disabled.  If null
     * or undefined, the list item is not printed at all.
     *
     * @since 0.1.0-beta.0 — Removed `false` in favour of `undefined`.
     */
    href?: string | undefined;

    /**
     * Child menu items, if any.
     */
    child?: MenuItem[] | undefined;

    /**
     * Aria label for the submenu.
     */
    childLabel?: string | false | undefined;

    /**
     * @since 0.1.0-beta.0
     */
    class?: ClassList | undefined;

    /**
     * Whether this item should be marked as the current page.
     */
    current?: boolean | undefined;

    /**
     * Whether this item should be opened in a new window.
     *
     * @since 0.1.0-beta.0 — Removed `false` in favour of `undefined`.
     */
    external?: true | undefined;

    /**
     * Attributes to apply to the list element for this item.
     *
     * @since 0.1.0-beta.6
     */
    itemAttrs?: ElementProps<{}, 'li'>;
};

/**
 * @since 0.1.0-beta.0
 */
export type SubmenuListOpts = {
    /**
     * Classes for the submenu(s).
     */
    classList: ClassList;
};

/**
 * Input props for the MenuList component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 * @since 0.1.0-beta.6 — Separator prop was removed. Replaced by a slot with the same name.
 */
export interface MenuListProps {
    /**
     * Attributes to apply to all list items.
     *
     * @since 0.1.0-beta.6
     */
    listItemAttrs?: ElementProps<{}, 'li'>;

    /**
     * An array of menu items to be displayed.
     *
     * Must have at least one item.
     */
    menu: MenuItem[];

    /**
     * Options for submenus, if any.
     *
     * @internal
     */
    submenu?: Partial<SubmenuListOpts>;

    /**
     * @since 0.1.0-beta.0
     */
    submenuWrapper?: boolean | DynamicWrapperComponentType;

    /**
     * Used to check for current page when its value isn't set.
     *
     * @since 0.1.0-beta.0
     */
    urlMaker?: undefined | ((currentURL: URL, targetSubpath: string) => string);
}

/* PROPS ===================================== */

type Props = ElementProps<MenuListProps, 'div', 'role'>;

const {
    menu,

    class: classList = [],
    listItemAttrs: { class: listItemClassList, ...listItemAttrs } = {},
    // @ts-expect-error - previous param that was removed in 0.1.0-beta.6
    separator = null,
    submenu: inputSubmenu = {},
    submenuWrapper = SUBMENU_HAS_WRAPPER,
    urlMaker: inputUrlMaker = absoluteInternalURL,
    ...attributes
}: Props = Astro.props;

const submenu = {
    ...inputSubmenu,
    classList: inputSubmenu.classList ?? 'nav__submenu',
};

const SubMenuWrapperComponent =
    typeof submenuWrapper === 'function'
        ? submenuWrapper
        : submenuWrapper && DynamicWrapper;

/* FUNCTIONS ===================================== */

export type MenuItemLabel =
    | {
          html: string;
          text: undefined;
      }
    | {
          html: undefined;
          text: string;
      };

export type UnlabelledMenuItem = MenuItemLabel &
    Omit<Classify<MenuItem>, 'href' | 'label' | 'labelHTML'> & {
        class: ClassList | undefined;
        childLabel: HTMLAttributes<'ul'>['aria-label'];
    };

export type ParsedMenuItem_NoHref = UnlabelledMenuItem & {
    attrs: ElementProps<{}, 'a', 'class' | 'href'>;
    href: false;
};

export type ParsedMenuItem_WithHref = UnlabelledMenuItem & {
    attrs: ElementProps<
        {
            'aria-current': HTMLAttributes<'a'>['aria-current'];
            'aria-label': HTMLAttributes<'a'>['aria-label'];
            'target': HTMLAttributes<'a'>['target'];
        },
        'a',
        'class' | 'href'
    >;

    href: string;
};

export type ParsedMenuItem = ParsedMenuItem_NoHref | ParsedMenuItem_WithHref;

export function parseItemAttributes(
    currentURL: URL,
    {
        attrs: { 'aria-label': ariaLabel, ...attrs } = {},
        child,
        childLabel: _childLabel,
        class: classList,
        current,
        external,
        href,
        itemAttrs,
        label,
        labelHTML,
    }: MenuItem,
    urlMaker: (
        currentURL: URL,
        targetSubpath: string,
    ) => string = absoluteInternalURL,
): ParsedMenuItem {
    const labels = {
        html: labelHTML || undefined,
        text: label || (labelHTML ? undefined : ''),
    } as MenuItemLabel;

    if (typeof current === 'undefined' && href?.match(/^#/g) === null) {
        current =
            urlMaker(currentURL, href) ===
            urlMaker(currentURL, currentURL.pathname);
    }

    let childLabel: UnlabelledMenuItem['childLabel'] = undefined;

    if (child?.length && _childLabel !== false) {
        childLabel = _childLabel;

        if (typeof childLabel === 'undefined') {
            const __label = href
                ? ariaLabel
                    ? ariaLabel
                    : (labels.text ?? '')
                : '';

            childLabel = __label + (__label ? ' ' : '') + 'sub-menu';
        }
    }

    // returns
    if (typeof href === 'undefined') {
        return {
            ...labels,
            href: false,

            child,
            childLabel,

            current,
            external,

            attrs,
            class: classList,

            itemAttrs,
        } as const satisfies ParsedMenuItem_NoHref;
    }

    return {
        ...labels,

        href,

        child,
        childLabel,

        current,
        external,

        attrs: {
            'target': href && external ? '_blank' : undefined,

            ...attrs,

            'aria-current': href && current ? 'page' : undefined,
            'aria-label': ariaLabel,
        },
        class: classList,

        itemAttrs,
    } as const satisfies ParsedMenuItem_WithHref;
}

/* CONSTANTS ===================================== */

const parsedMenu = menu.map((item) =>
    parseItemAttributes(Astro.url, item, inputUrlMaker),
);

const separatorHTML = (await Astro.slots.render('separator'))?.trim();
---

{
    menu && (
        <ul
            {...attributes}
            class={makeClassList.flat(classList)}
        >
            <slot name='start' />
            {parsedMenu.map(
                (
                    {
                        itemAttrs: { class: _itemClassList, ...itemAttrs } = {},
                        ...item
                    },
                    index,
                ) =>
                    (item.href || item.child) && (
                        <Fragment>
                            <li
                                {...listItemAttrs}
                                {...itemAttrs}
                                class={makeClassList.flat(
                                    listItemClassList ?? [],
                                    _itemClassList,
                                    { separator: false },
                                )}
                            >
                                {item.href ? (
                                    <a
                                        {...item.attrs}
                                        class={makeClassList.flat(
                                            item.class ?? [],
                                        )}
                                        href={item.href}
                                    >
                                        {item.html ? (
                                            <Fragment set:html={item.html} />
                                        ) : (
                                            <Fragment set:text={item.text} />
                                        )}
                                    </a>
                                ) : (
                                    item.child?.length && (
                                        <a
                                            {...item.attrs}
                                            class={makeClassList.flat(
                                                'nav__menu-item',
                                                item.class,
                                                { separator: '|' },
                                            )}
                                            tabindex={
                                                item.child?.length
                                                    ? -1
                                                    : undefined
                                            }
                                        >
                                            {item.html ? (
                                                <Fragment
                                                    set:html={item.html}
                                                />
                                            ) : (
                                                <Fragment
                                                    set:text={item.text}
                                                />
                                            )}
                                        </a>
                                    )
                                )}
                                {item.child?.length &&
                                    (SubMenuWrapperComponent ? (
                                        <SubMenuWrapperComponent
                                            class={submenu.classList}
                                        >
                                            <Astro.self
                                                aria-label={item.childLabel}
                                                menu={item.child}
                                                submenu={submenu}
                                            />
                                        </SubMenuWrapperComponent>
                                    ) : (
                                        <Astro.self
                                            aria-label={item.childLabel}
                                            class={submenu.classList}
                                            menu={item.child}
                                            submenu={submenu}
                                        />
                                    ))}
                            </li>
                            <Fragment
                                set:html={
                                    separatorHTML &&
                                    index < menu.length &&
                                    separatorHTML
                                }
                            />
                        </Fragment>
                    ),
            )}
            <slot />
            <slot name='end' />
        </ul>
    )
}
