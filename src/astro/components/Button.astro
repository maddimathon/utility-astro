---
/**
 * Exists just to allow easy override of button markup.
 *
 * @since 0.1.0-beta.3
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type {
    ElementProps,
    PropsRequireChildren,
} from '../../ts/types/index.ts';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Base = PropsRequireChildren<{
    variant?: string;
}>;

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Button = ButtonProps_Base & {
    href?: undefined;
    type: NonNullable<HTMLAttributes<'button'>['type']>;
};

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Link = ButtonProps_Base & {
    href: string;
    type?: undefined;
};

export type ButtonProps =
    | ElementProps<ButtonProps_Button, 'button'>
    | ElementProps<ButtonProps_Link, 'a'>;

type Props = ButtonProps;

export type ButtonComponentType = (props: ButtonProps) => any;

const { class: classList, href, type, variant, ...props } = Astro.props;

/* CONSTANTS ===================================== */
---

{
    href ? (
        <a
            {...props}
            class:list={makeClassList(
                variant ? `button-${variant}` : 'button',
                classList,
            )}
            href={href}
        >
            <slot />
        </a>
    ) : (
        <button
            {...props}
            class:list={makeClassList(
                variant ? `button-${variant}` : [],
                classList,
            )}
            type={type}
        >
            <slot />
        </button>
    )
}
