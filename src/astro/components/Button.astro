---
/**
 * Exists just to allow easy override of button markup.
 *
 * @since ___PKG_VERSION___
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type { GenericElementProps } from '../../ts/index.ts';
import { makeClassList } from '../functions';

/* import - functions */

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

/**
 * @since ___PKG_VERSION___
 */
export interface ButtonProps_Base {
    children: any;
    variant?: string;
}

/**
 * @since ___PKG_VERSION___
 */
export interface ButtonProps_Button extends ButtonProps_Base {
    href?: undefined;
    type: NonNullable<HTMLAttributes<'button'>['type']>;
}

/**
 * @since ___PKG_VERSION___
 */
export interface ButtonProps_Link extends ButtonProps_Base {
    href: string;
    type?: undefined;
}

export type ButtonProps =
    | GenericElementProps<ButtonProps_Button, 'button'>
    | GenericElementProps<ButtonProps_Link, 'a'>;

export type Props = ButtonProps;

export type ButtonComponentType = (props: ButtonProps) => any;

const {
    class: classList,
    href,
    type,
    variant,
    ...props
} = Astro.props.frontmatter ?? Astro.props;

/* CONSTANTS ===================================== */
---

{
    href ? (
        <a
            {...props}
            class:list={makeClassList(
                variant ? `button-${variant}` : 'button',
                classList,
            )}
            href={href}
        >
            <slot />
        </a>
    ) : (
        <button
            {...props}
            class:list={makeClassList(
                variant ? `button-${variant}` : [],
                classList,
            )}
            type={type}
        >
            <slot />
        </button>
    )
}
