---
/**
 * Exists just to allow easy override of button markup.
 *
 * @since 0.1.0-beta.3
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type {
    ElementProps,
    PropsOptionalChildren,
    PropsRequireChildren,
} from '../../ts/types/index.ts';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Base = {
    disabled?: boolean;
    variant?: string;
};

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Button = ButtonProps_Base & {
    href?: undefined;
    type: NonNullable<HTMLAttributes<'button'>['type']>;
};

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Link = ButtonProps_Base & {
    href: string;
    type?: undefined;
};

/**
 * @since 0.1.0-beta.6
 */
export type GenericButtonElementProps<
    T_Props extends {},
    T_Tag extends 'a' | 'button',
> = ElementProps<
    T_Props,
    T_Tag,
    | 'aria-disabled'
    | 'aria-readonly'
    | 'disabled'
    | 'href'
    | 'readonly'
    | 'type'
    | keyof T_Props
>;

export type ButtonProps =
    | GenericButtonElementProps<ButtonProps_Button, 'button'>
    | GenericButtonElementProps<ButtonProps_Link, 'a'>;

type Props =
    | GenericButtonElementProps<
          PropsRequireChildren<ButtonProps_Button>,
          'button'
      >
    | GenericButtonElementProps<PropsRequireChildren<ButtonProps_Link>, 'a'>;

export type ButtonComponentType = (
    attrs:
        | GenericButtonElementProps<
              PropsOptionalChildren<ButtonProps_Button>,
              'button'
          >
        | GenericButtonElementProps<
              PropsOptionalChildren<ButtonProps_Link>,
              'a'
          >,
) => any;

const {
    class: classList,
    disabled = false,
    href,
    type = 'button',
    variant,
    ...attrs
} = Astro.props;

/* CONSTANTS ===================================== */

const fullClassList = makeClassList.flat(
    variant && !disabled ? `button-${variant}` : href ? 'button' : [],
    classList,
);

const renderedContent = (await Astro.slots.render('default'))?.trim();
---

{
    href ? (
        <a
            {...attrs}
            aria-disabled={disabled ? 'true' : undefined}
            class={fullClassList}
            href={href}
            set:html={renderedContent}
        />
    ) : (
        <button
            {...attrs}
            class={fullClassList}
            disabled={disabled ? 'true' : undefined}
            set:html={renderedContent}
            type={type}
        />
    )
}
