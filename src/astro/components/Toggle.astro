---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLTag } from 'astro/types';
import type { ClassList, ElementProps } from '../../ts/types/index.js';

/* import - functions */
import { flattenClassList, makeClassList } from '../functions.js';

/* import - values */

/* import - components */
import Toggle_Backdrop from '../support/Toggle_Backdrop.astro';
import Toggle_Control from '../support/Toggle_Control.astro';
import Heading from './Heading.astro';

/* import - layouts */

/* PROPS ===================================== */

export type ToggleContainerType = 'modal' | 'menu' | 'nav';

/**
 * Input props for the Toggle component.
 *
 * @since 0.1.0-alpha
 */
export interface ToggleProps {
    children: any; // these are the slots

    /**
     * Unique id attr.
     */
    id: string;

    /**
     * @default false
     *
     * @since ___PKG_VERSION___
     */
    backdrop?: boolean;

    class?: ClassList | undefined;

    /**
     * Add an additional base class to use.
     */
    classBase?: string | undefined;

    defaultOpen?: boolean | undefined;

    /**
     * If any, the heading display level override for this heading (otherwise
     * the `heading` value is used).
     *
     * @default undefined
     *
     * @since 0.1.0-alpha.7 — Added false and undefined options.
     * @since ___PKG_VERSION___ — Removed false as an option. Use 0 instead.
     */
    displayHeading?: number | undefined;

    /**
     * To generate ID values for the component.
     *
     * @since ___PKG_VERSION___
     */
    generateID?: {
        button: (id: string) => string;
        content: (id: string) => string;
        title: (id: string) => string;
    };

    /**
     * If any, the heading level used to wrap the toggle button.
     *
     * @default 0
     *
     * @since ___PKG_VERSION___ — Removed false as an option. Use 0 instead.
     */
    heading?: number | undefined;

    /**
     * @since ___PKG_VERSION___
     */
    iconSVG?: string | undefined;

    /**
     * Minimum allowed heading level.
     *
     * @default 2
     *
     * @since ___PKG_VERSION___
     */
    minimumHeading?: number | undefined;

    /**
     * The HTML tag used for the container element.
     *
     * @default 'section'
     *
     * @since 0.1.0-alpha.7
     */
    tag?: 'div' | 'li' | 'nav' | 'section' | undefined;

    /**
     * The HTML tag used for the container element.
     *
     * @default 'section'
     *
     * @since 0.1.0-alpha.7
     */
    contentTag?: HTMLTag;

    /**
     * The HTML tag used for the container's header element. If tag is
     * 'section', default is 'header', else it is 'div'.
     *
     * @since 0.1.0-alpha.7
     */
    headerTag?: 'div' | 'header' | undefined;

    /**
     * @since ___PKG_VERSION___
     */
    titleAttributes?: Omit<
        ElementProps<{}, 'p'>,
        'aria-label' | 'aria-labelledby' | 'class:list' | 'id'
    >;

    /**
     * @since ___PKG_VERSION___
     */
    contentAttributes?: Omit<
        ElementProps<{}, 'div'>,
        'aria-label' | 'aria-labelledby' | 'class:list' | 'id'
    >;

    /**
     * @since ___PKG_VERSION___
     */
    contentContainerAttributes?: Omit<
        ElementProps<{}, 'div'>,
        'aria-label' | 'aria-labelledby' | 'class:list' | 'id'
    >;

    /**
     * Used to set the data-toggle-container-type attribute.
     *
     * @since ___PKG_VERSION___
     */
    type?: ToggleContainerType | ToggleContainerType[] | undefined;
}

type Props = ElementProps<
    ToggleProps,
    'div',
    'aria-label' | 'aria-labelledby' | 'class' | 'class:list'
>;

const {
    defaultOpen,
    id,
    // optional
    backdrop,
    class: classList,
    classBase,
    displayHeading,
    generateID = {
        button: (_id: string) => `${_id}-button`,
        content: (_id: string) => `${_id}-content`,
        title: (_id: string) => `${_id}-title`,
    },
    heading = 0,
    headerTag,
    iconSVG,
    minimumHeading = 2,
    tag: Container = 'section',
    contentTag: ContentContainer = 'section',
    contentAttributes,
    contentContainerAttributes,
    titleAttributes,
    type,
    ...attributes
}: Props = Astro.props;

const HeaderContainer = headerTag ?? 'div';

/* CONSTANTS ===================================== */

const buttonID = generateID.button(id);
const contentID = generateID.content(id);
const titleID = generateID.title(id);

const classMaker = classBase
    ? (append: string = '') =>
          'toggle-block' + append + ' ' + classBase + append
    : (append: string = '') => 'toggle-block' + append;

const containerTypes = !type ? [] : Array.isArray(type) ? type : [type];

const includeBackdrop =
    typeof backdrop === 'boolean'
        ? backdrop
        : containerTypes.includes('modal') || containerTypes.includes('nav');
---

<Container
    {...attributes}
    id={id}
    class:list={makeClassList(classMaker(), classList)}
    data-toggle-container={defaultOpen ? 'open' : 'closed'}
    data-toggle-container-type={containerTypes.join(' ')}
>
    <HeaderContainer
        {...titleAttributes}
        class={flattenClassList(
            makeClassList(classMaker('__title'), titleAttributes?.class),
        )}
        data-toggle-title={id}
        id={titleID}
    >
        <Heading
            class={classMaker('__title__heading')}
            data-toggle-title-heading={id}
            displayHeading={displayHeading}
            heading={heading}
            minimum={minimumHeading}
        >
            <Toggle_Control
                {...{ classBase, id, buttonID }}
                data-toggle-primary-control={id}
                iconSVG={iconSVG}
            >
                <slot name='button' />
            </Toggle_Control>
        </Heading>
    </HeaderContainer>

    <ContentContainer
        {...contentAttributes}
        aria-labelledby={titleID}
        class={flattenClassList(
            makeClassList(classMaker('__content'), contentAttributes?.class),
        )}
        data-toggle-content={id}
        id={contentID}
    >
        <div
            {...contentContainerAttributes}
            class={flattenClassList(
                makeClassList('container', contentContainerAttributes?.class),
            )}
        >
            <slot />
        </div>
    </ContentContainer>

    {
        includeBackdrop && (
            <Toggle_Backdrop
                classBase={classBase}
                toggleID={id}
            />
        )
    }
</Container>

<script src='../scripts/toggle.ts'></script>
