---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    ElementProps,
    PropsForbidChildren,
    PropsRequireChildren,
} from '../../../ts/types/index.js';

import type { IconProps } from '../Icon.astro';

/* import - functions */
import { flattenClassList, makeClassList } from '../../functions.js';

/* import - values */

/* import - components */
import Icon from '../Icon.astro';

/* import - layouts */

/* TYPES ===================================== */

export type AlertIconProps_Render = PropsRequireChildren<{
    type?: undefined;

    slug?: undefined;
    svg?: undefined;
    svgLabel?: undefined;
}>;

export type AlertIconProps_Slug = PropsForbidChildren<{
    type: IconProps['type'];

    slug?: undefined;
    svg?: undefined;
    svgLabel?: undefined;
}>;

export type AlertIconProps_Svg = PropsForbidChildren<{
    type?: undefined;

    slug: string;
    svg: string;
    svgLabel: string;
}>;

export type AlertIconProps =
    AlertIconProps_Render | AlertIconProps_Slug | AlertIconProps_Svg;

/* PROPS ===================================== */

type Props = ElementProps<AlertIconProps, 'span'>;

const {
    slug,
    svg,
    svgLabel,
    type = 'star',
    class: classListInput = [],
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const svgRender = (await Astro.slots.render('default'))?.trim() || undefined;

const classList = makeClassList('alert-block__icon', classListInput);
---

{
    svgRender ? (
        <span
            {...attributes}
            class={flattenClassList(classList)}
            set:html={svgRender}
        />
    ) : svg ? (
        <Icon
            {...attributes}
            class={classList}
            slug={slug}
            svg={svg}
            svgLabel={svgLabel}
        />
    ) : (
        <Icon
            {...attributes}
            class={classList}
            type={type}
        />
    )
}
