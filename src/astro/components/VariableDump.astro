---
/**
 * A component
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../ts/types/index.js';
import type { CodeBlockProps, CodeBlockComponentType } from './CodeBlock.astro';

/* import - functions */
import { VariableInspector } from '@maddimathon/utility-typescript';

/* import - values */

/* import - components */
import CodeBlockComponent from './CodeBlock.astro';

/* import - layouts */

/* TYPES ===================================== */

/**
 * Input props for the VariableDump component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export interface VariableDumpProps extends Omit<
    CodeBlockProps,
    'children' | 'lang'
> {
    /**
     * The variable to dump.
     */
    var: unknown;

    /**
     * Optional name to prefix the output.
     */
    name?: string;

    components?: Partial<{
        CodeBlock: CodeBlockComponentType;
    }>;
}

/* PROPS ===================================== */

type Props = ElementProps<VariableDumpProps, 'div'>;

const {
    var: variable,
    name,
    components: { CodeBlock = CodeBlockComponent } = {},
    ...props
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const stringified = VariableInspector.stringify(
    { [name ?? 'var']: variable },
    {
        includePrefix: !!name,
    },
).replace(/^[\n\s]+|[\n\s]+$/gi, '');
---

<CodeBlock
    {...props}
    lang={undefined}
    set:html={stringified}
/>
