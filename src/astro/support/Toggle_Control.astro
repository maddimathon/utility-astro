---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericElementProps } from '../../ts/types/index.js';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */
import RenderedSlotContent from '../components/RenderedSlotContent.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

type Props = Omit<GenericElementProps<{}, 'button'>, 'id'> & {
    id: string;
    buttonID: string;

    /**
     * Add an additional base class to use.
     */
    classBase?: string | undefined;

    includeDefaultBase?: boolean;

    icon?: boolean;
    iconSVG?: undefined | string;
};

const {
    buttonID,
    class: classList = [],
    classBase,
    id,
    includeDefaultBase = true,

    icon = true,

    iconSVG,

    ...attrs
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const buttonHTML = (await Astro.slots.render('default'))?.trim();

export const DEFAULT_TOGGLE_ICON = `<span class='icon icon--toggle | toggle-block__control__icon toggle-block__control__icon--fallback'>
    <svg
        aria-ignore='true'
        role='img'
        width='100%'
        height='100%'
        viewBox='0 0 24 24'
        version='1.1'
        xmlns='http://www.w3.org/2000/svg'
        xmlns:xlink='http://www.w3.org/1999/xlink'
        xml:space='preserve'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'
    >
        <path
            id='a'
            d='M5 12h14'
        />
        <path
            id='b'
            d='M12 5v14'
        />
    </svg>
</span>`;

const classMaker = classBase
    ? includeDefaultBase
        ? (append: string = '') =>
              'toggle-block' + append + ' ' + classBase + append
        : (append: string = '') => classBase + append
    : (append: string = '') => 'toggle-block' + append;
---

<button
    {...attrs}
    aria-disabled='true'
    class:list={makeClassList(classMaker('__control'), classList)}
    data-toggle-control={id}
    id={buttonID}
    type='button'
>
    {icon && <Fragment set:html={iconSVG ?? DEFAULT_TOGGLE_ICON} />}
    {
        (!attrs['aria-label'] || buttonHTML) && (
            <span class={classMaker('__control__inner')}>
                <RenderedSlotContent
                    html={buttonHTML}
                    name='button'
                >
                    <Fragment
                        slot='empty-before'
                        set:text={'Toggle me'}
                    />
                </RenderedSlotContent>
            </span>
        )
    }
</button>

<style lang='scss'>
    @forward '../css/icon.css';
</style>
