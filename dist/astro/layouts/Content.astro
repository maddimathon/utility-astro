---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericProps } from '../../ts/types/index.js';

import type {
    ContentType,
    ContentTypeInput,
    DefaultContentType,
    ContentProps,
    ContentProps_Full,
} from './Content.d.ts';

/* import - functions */
import { mergeArgs } from '@maddimathon/utility-typescript';

/* import - values */

/* import - components */
import { Heading } from '../components.ts';

import Content_ExtraWide from './content/Content_ExtraWide.astro';
import Content_FullWidth from './content/Content_FullWidth.astro';
import Content_Only from './content/Content_Only.astro';
import Content_Sidebar from './content/Content_Sidebar.astro';

/* import - layouts */

/* TYPES ===================================== */

export type * from './Content.d.ts';

/* PROPS ===================================== */

// prettier-ignore
type Props<T_Type extends ContentTypeInput = DefaultContentType> = GenericProps<ContentProps<T_Type>>;

type DefaultProps = ContentProps_Full<string> &
    Pick<Required<Props<ContentTypeInput>>, 'type'>;

const _defProps = {
    type: 'content-only' as Extract<ContentTypeInput, string>,

    title: undefined,
    subtitle: undefined,

    attrs: {
        main: {},
        sidebar: {},
    },
} as const satisfies DefaultProps;

const { type = 'content-only', ...p } = mergeArgs(
    _defProps as DefaultProps,
    Astro.props.frontmatter ?? Astro.props,
    true,
);

/* CONSTANTS ===================================== */

const title = Array.isArray(p.title)
    ? p.title.length
        ? p.title
        : []
    : p.title?.length
      ? [p.title]
      : [];

const titleString = title.reverse().join(' / ');

/**
 * @since 0.1.0-beta.0 — Added to exports.
 */
const contentTypes = {
    'content-only': Content_Only,
    'full-width': Content_FullWidth,
    'extra-wide': Content_ExtraWide,
    'sidebar-left': Content_Sidebar,
    'sidebar-right': Content_Sidebar,
} as const satisfies {
    [K in ContentType]: (props: ContentProps_Full<K>) => any;
};

const [typeSlug, ContentComponent] = Array.isArray(type)
    ? type
    : type && type in contentTypes
      ? [type, contentTypes[type as ContentType]]
      : [_defProps.type, contentTypes[_defProps.type]];

const completedProps = {
    ...{ ...p, type: typeSlug },
} satisfies ContentProps_Full<string>;
---

<ContentComponent {...completedProps}>
    {
        titleString ? (
            <Heading
                slot='content-header'
                attrs={{ subheading: { class: 'page-title__subheading' } }}
                class='page-title'
                heading={1}
                minimum={1}
            >
                <Fragment set:text={titleString} />
                <Fragment
                    slot='subheading'
                    set:text={p.subtitle}
                />
            </Heading>
        ) : (
            p.subtitle && (
                <p
                    slot='content-header'
                    class='page-title__subheading'
                    set:text={p.subtitle}
                />
            )
        )
    }

    <slot
        slot='content-header'
        name='content-header'
    />
    <slot
        slot='before-main-content'
        name='before-main-content'
    />
    <slot />
    <slot
        slot='after-main-content'
        name='after-main-content'
    />
    <slot
        slot='sidebar'
        name='sidebar'
    />
</ContentComponent>
