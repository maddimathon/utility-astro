---
/**
 * @package boilerplate-astro-project@0.1.0-beta.6.draft
 * @since 0.1.0-alpha
 */

/* import - types */
import type { PartialExcept } from '@maddimathon/utility-typescript/types';

import type { GenericProps } from '../../ts/index.ts';

import type { NavMenuProps, SettingsMenuProps } from '../components.ts';

import type {
    ContentProps,
    ContentProps_Full,
    ContentTypeInput,
    DefaultContentType,
} from './Content.astro';

import type { PageProps } from './Page.d.ts';

/* import - functions */
import { mergeArgs, slugify } from '@maddimathon/utility-typescript';
import { FeatureCheck } from '@maddimathon/utility-sass';

import { mapToObject } from '../../ts/index.js';
import { absoluteInternalURL, currentPagePath, makeClassList } from '../functions.js';

/* import - values */

/* import - layouts */
import Content from './Content.astro';

/* import - components */
import {
    Heading as HeadingComponent,
    NavMenu,
    Page_Meta,
    RenderedSlotContent,
    SettingsMenu as SettingsMenuComponent,
    SiteFooter as SiteFooterComponent,
    SkipLinks,
    ToggleNavMenu,
} from '../components.ts';

/** ## TYPES ==================================== **/

export type * from './Page.d.ts';

/** ## FUNCTIONS ==================================== **/

/**
 * Parses Page layout input props into a more consistent output.
 * 
 * @since 0.1.0-beta.6.draft
 */
export function parsePageProps<T_ContentType extends ContentTypeInput = DefaultContentType>(
    currentURL: URL,
    {
        attrs,
        components: inputComponents,
        content: inputContent,
        dir = 'auto',
        lang,
        primaryMenu,
        secondaryMenu,
        settings: inputSettings,
        scripts: inputScripts,
        subtitle,
        urlMaker = absoluteInternalURL,
        ...p
    }: PageProps<T_ContentType>
) {

    const components = {
        ...inputComponents ?? {},
        Heading : inputComponents?.Heading ?? HeadingComponent,
        SettingsMenu : inputComponents?.SettingsMenu ?? SettingsMenuComponent,
        SiteFooter : inputComponents?.SiteFooter ?? SiteFooterComponent,
    } satisfies ContentProps_Full<any>['components'];

    const content = {
        ...inputContent,

        components,

        subtitle,

        title: Array.isArray(p.title)
            ? p.title.length
                ? p.title
                : []
            : p.title.length
            ? [p.title]
            : [],

        layout: p.layout ?? ('content-only' satisfies DefaultContentType as T_ContentType),
    } satisfies ContentProps<T_ContentType>;

    /**
     * The menu params constructed from input props.
     */
    const menus: {
        primary?: NavMenuProps;
        secondary?: NavMenuProps;
    } = {};

    for (const [menuInput, ariaLabel, id] of [
        [primaryMenu, 'Primary Menu', 'primary-menu'],
        [secondaryMenu, 'Secondary Menu', 'secondary-menu'],
    ] as const) {
        if (menuInput) {
            let _menu: PartialExcept<NavMenuProps, 'menu'>;

            if (Array.isArray(menuInput)) {
                _menu = {
                    menu: menuInput,
                };
            } else {
                _menu = menuInput;
            }

            menus.primary = {
                'aria-label': ariaLabel,
                id,
                ..._menu,
                convertHrefStringsToAbsolute: p.convertHrefStringsToAbsolute,
            };

            if (urlMaker) {
                menus.primary.urlMaker = urlMaker;
            }
        }
    }

    const settings = inputSettings && {
        ...(inputSettings === true ? {} : inputSettings),

        accessibilityReportEmail: p.accessibilityReportEmail,
        privacyPolicy: p.privacyPolicy,

        components: components as SettingsMenuProps['components'],
    } as const satisfies SettingsMenuProps;

    const scripts = mergeArgs(
        {
            featureCheck: true,
        },
        inputScripts,
    );

    const layoutSlug = Array.isArray(content.layout) ? content.layout[0] : content.layout as Exclude<T_ContentType, any[]>;

    const pageSlug: string =
        slugify(currentPagePath(currentURL).replace(/\.(html|php)$/gi, '')) ||
        'home';

    const featureClasses = scripts.featureCheck ? FeatureCheck.DEFAULT_CLASSLIST() : [];

    const attributes = {

        html: {
            ...attrs?.html,

            class: makeClassList.flat( attrs?.html?.class ?? [], featureClasses ),
            dir,
            lang,
        },

        body: {
            ...attrs?.body,

            class: makeClassList.flat(
                    [
                        `page_${pageSlug}`,
                        content.layout && `layout_${slugify(layoutSlug)}`,
                    ],
                    attrs?.body?.class,
                ),
        },
    } as const;

    return {
        ...p,
        attributes,
        components,
        content,
        dir,
        lang,
        layoutSlug,
        menus,
        pageSlug,
        scripts,
        settings,
        urlMaker,
    } as const;
}

/** ## PROPS ==================================== **/

type Props<T_ContentType extends ContentTypeInput = ContentTypeInput> = GenericProps<
    PageProps<T_ContentType>
>;

const {
    attributes,
    components,
    content,
    footer,
    header,
    lang,
    menus,
    meta,
    settings,
    skipLinks,
} = parsePageProps(Astro.url, Astro.props.frontmatter ?? Astro.props);

const {
    PrimaryMenu = ToggleNavMenu,
    SecondaryMenu = NavMenu,
    SettingsMenu = SettingsMenuComponent,
    SiteFooter = SiteFooterComponent,
} = components;


/** ## CONSTANTS ==================================== **/

const SiteTitleTag = content.title && content.title.length ? 'p' : 'h1';

/* ### Slots ------------------ */

/**
 * Rendered slot HTML.
 */
const slots_render = mapToObject(
    await Promise.all(
        (
            [
                'afterFooter',
                'afterHeader',
                'afterPrimaryNav',
                'afterSecondaryNav',
                'beforeFooter',
                'beforeHeader',
                'beforePrimaryNav',
                'beforeSecondaryNav',
                'bodyClose',
                'bodyOpen',
                'footer',
                'footerLast',
                'footerScripts',
                'headClose',
                'header',
                'headOpen',
            ] as const
        ).map(async (_key) => {
            const _kebab = _key.replace(
                /([a-z0-9])([A-Z])/g,
                (_v, _cap1, _cap2) => _cap1 + '-' + _cap2.toLowerCase(),
            );

            return [
                _key,
                Astro.slots.has(_kebab) &&
                    (await Astro.slots.render(_kebab))?.trim(),
            ] as const;
        }),
    ),
);

/* ### Include ------------------ */

/**
 * Sections/components to include or not.
 */
const include = {
    header: header && (header.title || header.tagline || slots_render.header),
};
---

<html {...attributes.html}>
    <!-- 
        This page includes html generated using
        @maddimathon/utility-astro@0.1.0-beta.6.draft

        Author: Maddi Mathon (https://www.maddimathon.com/web)
        License: MIT
    -->
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width,initial-scale=1' />
        { lang && <meta property='og:locale' content={lang} /> }
        <RenderedSlotContent
            name='head-open'
            html={slots_render.headOpen}
        />
        <Page_Meta {...meta} />
        <RenderedSlotContent
            name='head-close'
            html={slots_render.headClose}
        />
    </head>

    <body {...attributes.body}>
        {skipLinks && <SkipLinks links={skipLinks} />}

        <RenderedSlotContent
            name='body-open'
            html={slots_render.bodyOpen}
        />

        {
            settings && (
                <SettingsMenu {...settings}>
                    <slot
                        name='settings-menu-open'
                        slot='settings-menu-open'
                    />
                    <slot name='settings-menu' />
                    <slot
                        name='settings-menu-close'
                        slot='settings-menu-close'
                    />
                </SettingsMenu>
            )
        }

        <RenderedSlotContent
            name='before-header'
            html={slots_render.beforeHeader}
        />

        {
            include.header && (
                <header class='site-header'>
                    {header?.title && (
                        <SiteTitleTag
                            class='site-title'
                            set:text={header.title}
                        />
                    )}
                    {header?.tagline && (
                        <p
                            class='site-tagline'
                            set:text={header.tagline}
                        />
                    )}

                    <RenderedSlotContent
                        name='header'
                        html={slots_render.header}
                    />
                </header>
            )
        }

        {
            menus.primary && menus.primary.menu.length > 0 && (
                <RenderedSlotContent
                    name='before-primary-nav'
                    html={slots_render.beforePrimaryNav}
                />
                <PrimaryMenu
                    {...menus.primary}
                    class='nav-primary'
                />
                <RenderedSlotContent
                    name='after-primary-nav'
                    html={slots_render.afterPrimaryNav}
                />
            )
        }

        <RenderedSlotContent
            name='after-header'
            html={slots_render.afterHeader}
        />

        <Content {...content}>
            <slot
                slot='content-header'
                name='content-header'
            />
            <slot
                slot='before-main-content'
                name='before-main-content'
            />
            <slot />
            <slot
                slot='after-main-content'
                name='after-main-content'
            />
            <slot
                slot='sidebar'
                name='sidebar'
            />
        </Content>

        {
            menus.secondary && menus.secondary.menu.length > 0 && (
                <RenderedSlotContent
                    name='before-secondary-nav'
                    html={slots_render.beforeSecondaryNav}
                />
                <SecondaryMenu
                    {...menus.secondary}
                    class='nav-secondary'
                />
                <RenderedSlotContent
                    name='after-secondary-nav'
                    html={slots_render.afterSecondaryNav}
                />
            )
        }

        <RenderedSlotContent
            name='before-footer'
            html={slots_render.beforeFooter}
        />

        {
            footer && (
                <SiteFooter {...footer.attributes} content={footer} components={components}>
                    <RenderedSlotContent
                        name='footer'
                        html={slots_render.footer}
                    />
                    <Fragment
                        slot='footer-last'
                    ><RenderedSlotContent
                        name='footer-last'
                        html={slots_render.footerLast}
                    /></Fragment>
                </SiteFooter>
            )
        }

        <RenderedSlotContent
            name='after-footer'
            html={slots_render.afterFooter}
        />
        <RenderedSlotContent
            name='body-close'
            html={slots_render.bodyClose}
        />
        <RenderedSlotContent
            name='footer-scripts'
            html={slots_render.footerScripts}
        />
    </body>
</html>

<script src='../scripts/feature-check-init.ts'></script>
