---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type { ClassList } from '../../ts/types/index.js';
import type { ButtonComponentType, ButtonProps_Button } from './Button.astro';

/* import - functions */

/* import - values */

/* import - components */
import ButtonComponent from './Button.astro';

/* import - layouts */

/* TYPES ===================================== */

// prettier-ignore
export type CopyToClipboardButtonProps = CopyToClipboardButtonProps.WithChildren | CopyToClipboardButtonProps.WithSetHtml | CopyToClipboardButtonProps.WithSetText;

export namespace CopyToClipboardButtonProps {
    type Base = Omit<ButtonProps_Button, 'children' | 'type'> & {
        /**
         * Timeout length to switch the button to active state, in milliseconds.
         */
        activeTimeout?: undefined | number;

        /**
         * @since 0.1.0-beta.2.draft
         */
        components?:
            | undefined
            | Partial<{
                  Button: ButtonComponentType;
              }>;

        /**
         * Timeout length to display the success message, in milliseconds.
         */
        messageTimeout?: undefined | number;

        /**
         * Content to copy to clipboard.
         */
        toClipboard: string;

        /**
         * Success message to display when copied.
         */
        successMessage?: string;
    };

    export type WithChildren = Base & {
        /**
         * Must have content to label the button (or intentionally leave it blank).
         */
        children: any;
    };

    export type WithSetHtml = Base & {
        'set:html': string;
    };

    export type WithSetText = Base & {
        'set:text': string;
    };
}

/* PROPS ===================================== */

// prettier-ignore
type Props = ( CopyToClipboardButtonProps.WithChildren | CopyToClipboardButtonProps.WithSetHtml | CopyToClipboardButtonProps.WithSetText ) & Omit<HTMLAttributes<'button'>, 'class'|'type'> & {
    class?: undefined | ClassList;
};

const {
    activeTimeout,
    // copyAs,
    components: { Button = ButtonComponent } = {},
    messageTimeout,
    successMessage,
    toClipboard,

    class: classListInput = [],
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const classList = [
    'button--copy-to-clipboard',
    { '||': classListInput },
    classListInput,
];
---

<Button
    {...attributes}
    class:list={classList}
    data-copy-to-clipboard={toClipboard}
    data-copy-to-clipboard-success={successMessage}
    data-copy-to-clipboard-active-timeout={activeTimeout}
    data-copy-to-clipboard-message-timeout={messageTimeout}
    type='button'
    ><slot /></Button
><script>
    import { CopyToClipboard } from '../../ts/classes/CopyToClipboard.js';
    CopyToClipboard.run();
</script>
