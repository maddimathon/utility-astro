---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    ElementProps,
    PropsRequireChildren,
} from '../../ts/types/index.js';
import type { ButtonComponentType, ButtonProps_Button } from './Button.astro';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */
import ButtonComponent from './Button.astro';

/* import - layouts */

/* TYPES ===================================== */

export type CopyToClipboardButtonProps = PropsRequireChildren<
    Omit<ButtonProps_Button, 'type'> & {
        /**
         * Timeout length to switch the button to active state, in milliseconds.
         */
        activeTimeout?: number | undefined;

        /**
         * @since 0.1.0-beta.3
         */
        components?:
            | undefined
            | Partial<{
                  Button: ButtonComponentType;
              }>;

        /**
         * @since 0.1.0-beta.6.draft
         */
        includeScript?: boolean | undefined;

        /**
         * Timeout length to display the success message, in milliseconds.
         */
        messageTimeout?: number | undefined;

        /**
         * Content to copy to clipboard.
         */
        toClipboard: string;

        /**
         * Success message to display when copied.
         */
        successMessage?: string | undefined;
    }
>;

export type CopyToClipboardComponentType = (
    props: ElementProps<CopyToClipboardButtonProps, 'button', 'type'>,
) => any;

/* FUNCTIONS ===================================== */

/**
 * Generates the attributes/props for the button element.
 *
 * @since 0.1.0-beta.6.draft
 */
export function copyToClipboardButtonAttributes({
    activeTimeout,
    messageTimeout,
    successMessage,
    toClipboard,

    class: classListInput = [],
    ...attributes
}: Omit<
    ElementProps<CopyToClipboardButtonProps, 'button'>,
    'components' | 'includeScript' | 'type'
>): ElementProps<
    ButtonProps_Button,
    'button',
    | 'aria-disabled'
    | 'aria-readonly'
    | 'disabled'
    | 'readonly'
    | keyof ButtonProps_Button
> {
    return {
        ...attributes,

        'class': makeClassList('button--copy-to-clipboard', classListInput),
        'data-copy-to-clipboard': toClipboard,
        'data-copy-to-clipboard-success': successMessage,
        'data-copy-to-clipboard-active-timeout': activeTimeout?.toString(),
        'data-copy-to-clipboard-message-timeout': messageTimeout?.toString(),

        'type': 'button',
    } satisfies ElementProps<
        Omit<ButtonProps_Button, 'set:html' | 'set:text'>,
        'button',
        | 'aria-disabled'
        | 'aria-readonly'
        | 'disabled'
        | 'readonly'
        | keyof ButtonProps_Button
    > as ElementProps<
        ButtonProps_Button,
        'button',
        | 'aria-disabled'
        | 'aria-readonly'
        | 'disabled'
        | 'readonly'
        | keyof ButtonProps_Button
    >;
}

/* PROPS ===================================== */

type Props = ElementProps<CopyToClipboardButtonProps, 'button', 'type'>;

const {
    components: { Button = ButtonComponent } = {},
    includeScript = true,
    ...props
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const fullAttributes = copyToClipboardButtonAttributes(props);
---

<Button {...fullAttributes}><slot /></Button>

{
    includeScript && (
        <script>
            import {CopyToClipboard} from '../../ts/classes/CopyToClipboard.js';
            CopyToClipboard.run();
        </script>
    )
}
