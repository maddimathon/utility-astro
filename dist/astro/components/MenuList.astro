---
/**
 * @since 0.1.0-alpha
 * 
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type { Classify } from '@maddimathon/utility-typescript/types';
import type { ClassList, GenericElementProps } from '../../ts/types/index.js';

/* import - functions */
import { absoluteInternalURL, makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */


/* TYPES ===================================== */

export type BaseMenuItem = {
    /** 
     * Display text for this link item.
     */
    label: string;
    labelHTML?:undefined;
} | {
    label?:undefined;
    /** 
     * Display HTML for this link item.
     */
    labelHTML: string;
};

/**
 * A single menu item for the MenuList component.
 * 
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export type MenuItem = BaseMenuItem & {

    /**
     * Optional aria label for this link.
     * 
     * @since 0.1.0-beta.0.draft
     */
    ariaLabel?: string |  undefined;

    /**
     * If false, the link prints without href and with aria-disabled.  If null
     * or undefined, the list item is not printed at all.
     * 
     * @since 0.1.0-beta.0.draft — Removed `false` in favour of `undefined`.
     */
    href?: string |  undefined;

    /**
     * Child menu items, if any.
     */
    child?: MenuItem[] | undefined;

    /**
     * Whether this item should be marked as the current page.
     */
    current?: boolean | undefined;

    /**
     * Whether this item should be opened in a new window.
     * 
     * @since 0.1.0-beta.0.draft — Removed `false` in favour of `undefined`.
     */
    external?: true | undefined;

    /**
     * @since 0.1.0-beta.0.draft
     */
    class?: ClassList | undefined;
}

/**
 * Input props for the MenuList component.
 * 
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export interface MenuListProps {

    /**
     * An array of menu items to be displayed.
     * 
     * Must have at least one item.
     */
    menu: MenuItem[];

    /** 
     * Escaped HTML to insert between list items.
     */
    separator?: string | null;

    /** 
     * If the current menu is a submenu. Should probably only be used by the
     * component itself.
     * 
     * @internal
     */
    submenu?: boolean;

    /**
     * Used to check for current page when its value isn't set.
     * 
     * @since 0.1.0-beta.0.draft
     */
    urlMaker?: undefined | ((currentURL: URL, targetSubpath: string) => string);
}


/* PROPS ===================================== */
    
type Props = Omit<GenericElementProps<MenuListProps, "div">, 'role'>;

const {
    menu,
    
    class: classList = [],
    separator = null,
    submenu = false,
    urlMaker: inputUrlMaker = absoluteInternalURL,
    ...attributes
}: Props = Astro.props.frontmatter ?? Astro.props;


/* FUNCTIONS ===================================== */

export type MenuItemLabel = {
        html: string;
        text: undefined;
    } | {
        html: undefined;
        text: string;
    };

export type UnlabelledMenuItem = MenuItemLabel & Omit<Classify<MenuItem>, 'ariaLabel' | 'href' | 'label' | 'labelHTML'>;

export type ParsedMenuItem_NoHref = UnlabelledMenuItem & {
    href: false;
};

export type ParsedMenuItem_WithHref = UnlabelledMenuItem & {
    href: string;

    'aria-current': HTMLAttributes<'a'>['aria-current'];
    'aria-label': HTMLAttributes<'a'>['aria-label'];
    target: HTMLAttributes<'a'>['target'];
};

export type ParsedMenuItem = ParsedMenuItem_NoHref | ParsedMenuItem_WithHref;

export function parseItemAttributes(
    currentURL: URL,
    item: MenuItem,
    urlMaker: (currentURL: URL, targetSubpath: string) => string = absoluteInternalURL,
): ParsedMenuItem {

    const labels =  {
        html: item.labelHTML || undefined,
        text: item.label || (item.labelHTML ? undefined : ''),
    } as MenuItemLabel ;
    
    const {href} = item;

    if (href?.match(/^#/g) === null && typeof item.current === 'undefined') {
        item.current = urlMaker(currentURL, href) === urlMaker(currentURL, currentURL.pathname)
    }
    
    // returns 
    if ( typeof href === 'undefined'  ) {

        return {
           ...labels,
            href: false,
            current: item.current,
            external: item.external,
            child: item.child,
            class: item.class,
        } as const satisfies ParsedMenuItem_NoHref;
    }
    
    return {
           ...labels,
        href,
        current: item.current,
        external: item.external,
        child: item.child,
        
        class: item.class,
        target: ( item.href && item.external ) ? '_blank' : undefined,
        'aria-current': ( item.href && item.current ) ? 'page' : undefined,
        'aria-label': item.ariaLabel,
    } as const satisfies ParsedMenuItem_WithHref;
}


/* CONSTANTS ===================================== */

const parsedMenu = menu.map(item => parseItemAttributes(Astro.url, item, inputUrlMaker));

---

{ menu && (
    <ul 
        {...attributes} 
        class:list={[ {submenu}, classList ]}
    >
        { parsedMenu.map( ( item, index ) =>  ( item.href || item.child ) && (
            <li>
                { item.href ? (
                    <a
                        class:list={item.class ?? ''}
                        href={ item.href }
                        target={ item.target }
                        aria-current={ item['aria-current'] }
                        aria-label={ item['aria-label'] }
                    >{ item.html ? <Fragment set:html={ item.html } /> : <Fragment set:text={ item.text } /> }</a> 
                ) : item.child?.length && (
                    <span
                        class:list={makeClassList('nav__menu-item', item.class)}
                    >{ item.html ? <Fragment set:html={ item.html } /> : <Fragment set:text={ item.text } /> }</span>
                ) }
                { item.child?.length && <Astro.self menu={ item.child } submenu={ true } /> }
            </li>
            <Fragment set:html={ separator && index < menu.length && separator } />
        ) )  }
    </ul>
) }