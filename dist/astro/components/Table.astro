---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../ts/types/index.js';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/**
 * Input props for the Table component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export type TableProps = ElementProps<
    {
        wrapper?: ElementProps<
            {
                tag?: 'div' | 'section';
            },
            'div'
        >;
    },
    'div'
>;

export type TableComponentType = (props: TableProps) => any;

/* PROPS ===================================== */

type Props = TableProps;

const {
    class: classList = [],
    wrapper: {
        class: wrapperClassList = [],
        tag: Wrapper = 'div',
        ...wrapperAttrs
    } = {},
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */
---

<Wrapper
    {...wrapperAttrs}
    class:list={makeClassList('table-wrapper', wrapperClassList)}
>
    <table
        {...attributes}
        class:list={makeClassList('table-wrapper--table', classList)}
    >
        <slot />
    </table>
</Wrapper>
<style>
    .table-wrapper {
        position: relative;
        max-width: 100%;

        > table {
            min-width: 100%;
        }
    }
</style>
