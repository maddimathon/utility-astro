---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { ElementProps } from '../../../ts/types/index.js';

import type {
    GenericDynamicWrapperProps,
    DynamicWrapperComponentType,
} from '../DynamicWrapper.astro';
import type { HeadingComponentType } from '../Heading.astro';

import type { AlertIconProps } from './Alert_Icon.astro';

/* import - functions */
import { makeClassList } from '../../functions.js';

/* import - values */

/* import - components */
import Alert_Icon from './Alert_Icon.astro';
import DynamicWrapperComponent from '../DynamicWrapper.astro';
import HeadingComponent from '../Heading.astro';

/* import - layouts */

/* TYPES ===================================== */

/**
 * Input props for the Alert component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file and renamed to AlertProps.
 */
export type AlertProps<
    T_IconProps extends AlertIconProps,
    T_Tag extends 'article' | 'div' | 'section' | null | false = 'div',
> = GenericDynamicWrapperProps<
    T_IconProps & {
        components?: Partial<{
            DynamicWrapper: DynamicWrapperComponentType;
            Heading: HeadingComponentType;
        }>;
        displayHeading?: number;
        heading?: number;
        minimumHeading?: number;
    },
    T_Tag
>;

export type AlertComponentType = (props: AlertProps<any>) => any;

/* PROPS ===================================== */

type Props = ElementProps<AlertProps<any>, 'section'>;

const {
    components: {
        DynamicWrapper = DynamicWrapperComponent,
        Heading = HeadingComponent,
    } = {},
    displayHeading,
    heading,
    minimumHeading = 2,
    slug,
    svg,
    svgLabel,
    tag = 'section',
    type = 'star',
    class: classList = [],
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const iconProps = {
    slug,
    svg,
    svgLabel,
    type,
} as ComponentProps<typeof Alert_Icon>;

const headlineHTML =
    Astro.slots.has('headline') &&
    (await Astro.slots.render('headline'))?.trim();
---

<DynamicWrapper
    {...attributes}
    class:list={makeClassList(
        ['alert-block', `alert-block--${slug ?? type}`],
        classList,
    )}
    tag={tag}
>
    {
        !headlineHTML ? (
            <Alert_Icon {...iconProps}>
                <slot name='icon' />
            </Alert_Icon>
        ) : (
            <Heading
                fallbackTag='header'
                displayHeading={displayHeading}
                heading={heading}
                minimum={minimumHeading}
                class='alert-block__headline'
            >
                <Alert_Icon {...iconProps}>
                    <slot name='icon' />
                </Alert_Icon>
                <span set:html={headlineHTML} />
            </Heading>
        )
    }
    <slot />
</DynamicWrapper>
