---
/**
 * Exists just to allow easy override of button markup.
 *
 * @since 0.1.0-beta.3
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type {
    ElementProps,
    PropsRequireChildren,
} from '../../ts/types/index.ts';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Base = PropsRequireChildren<{
    disabled?: boolean;
    variant?: string;
}>;

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Button = ButtonProps_Base & {
    href?: undefined;
    type: NonNullable<HTMLAttributes<'button'>['type']>;
};

/**
 * @since 0.1.0-beta.3
 */
export type ButtonProps_Link = ButtonProps_Base & {
    href: string;
    type?: undefined;
};

/**
 * @since 0.1.0-beta.6.draft
 */
export type GenericButtonElementProps<
    T_Props extends {},
    T_Tag extends 'a' | 'button',
> = ElementProps<
    T_Props,
    T_Tag,
    | 'aria-disabled'
    | 'aria-readonly'
    | 'disabled'
    | 'href'
    | 'readonly'
    | 'type'
    | keyof T_Props
>;

export type ButtonProps =
    | GenericButtonElementProps<ButtonProps_Button, 'button'>
    | GenericButtonElementProps<ButtonProps_Link, 'a'>;

type Props = ButtonProps;

export type ButtonComponentType = (attrs: ButtonProps) => any;

const {
    class: classList,
    disabled = false,
    href,
    type = 'button',
    variant,
    ...attrs
} = Astro.props;

/* CONSTANTS ===================================== */

const fullClassList = makeClassList.flat(
    variant && !disabled ? `button-${variant}` : [],
    classList,
);
---

{
    href ? (
        <a
            {...attrs}
            aria-disabled={disabled ? 'true' : undefined}
            class={fullClassList}
            href={href}
        >
            <slot />
        </a>
    ) : (
        <button
            {...attrs}
            class={fullClassList}
            disabled={disabled ? true : undefined}
            type={type}
        >
            <slot />
        </button>
    )
}
