---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../ts/types/index.js';
import type { HTMLTag } from 'astro/types';

/* import - functions */
import { makeNumber, objectOmit } from '@maddimathon/utility-typescript';
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

/**
 * Input props for the Heading component.
 *
 * @since 0.1.0-alpha
 */
export type HeadingProps<T_FallbackTag extends HTMLTag = HTMLTag> =
    ElementProps<
        {
            /**
             * If any, the heading display level override for this heading (otherwise
             * the `heading` value is used).  If false, a 'unstyled-heading' utility
             * class is adding to the heading.
             *
             * @since 0.1.0-alpha.7 — Added false and undefined options.
             */
            displayHeading?: number | undefined;

            /**
             * @since 0.1.0-beta.0
             */
            fallbackTag?: T_FallbackTag | undefined;

            /**
             * Logical heading order value for this heading.
             */
            heading?: number | undefined;

            /**
             * The minimum allowed value for this heading.
             */
            minimum?: number | undefined;

            /**
             * Additional attributes for other elements.
             */
            attrs?:
                | undefined
                | {
                      hgroup?: undefined | ElementProps<{}, 'hgroup'>;
                      subheading?: undefined | ElementProps<{}, 'p'>;
                  };
        },
        'div'
    >;

type Props = HeadingProps;

export type HeadingComponentType = (props: Props) => any;

/* FUNCTIONS ===================================== */

export function parseHeadingParams<T_FallbackTag extends HTMLTag>(
    html: { content: string; subheading: string },
    _props: HeadingProps<T_FallbackTag> & { debug?: boolean },
) {
    const {
        attrs: { hgroup: attrs_hgroup, subheading: attrs_subheading } = {},
        class: classList = [],
        displayHeading: displayHeadingRaw,
        fallbackTag = 'p' as T_FallbackTag,
        heading: headingRaw = 0,
        minimum = 2,
        debug = false,
        ...attributes
    } = _props;

    const heading = Math.round(Number(headingRaw));

    const numDisplayHeadingRaw =
        makeNumber(displayHeadingRaw) ?? displayHeadingRaw;

    const displayHeading =
        typeof numDisplayHeadingRaw === 'number'
            ? Math.round(numDisplayHeadingRaw)
            : typeof numDisplayHeadingRaw === 'undefined'
              ? numDisplayHeadingRaw
              : -1;

    const headingIsMoreThanMinimum = heading >= Math.max(1, minimum);

    const headingClass =
        typeof displayHeading === 'undefined' || displayHeading < 0
            ? !heading
                ? ('unstyled-heading' as const)
                : heading > 6
                  ? (`h${heading}` as const)
                  : headingIsMoreThanMinimum
                    ? ('' as const)
                    : ('unstyled-heading' as const)
            : displayHeading < 1
              ? ('unstyled-heading' as const)
              : (`h${displayHeading}` as const);

    const headingTag =
        headingIsMoreThanMinimum && heading < 7
            ? (`h${heading as 1 | 2 | 3 | 4 | 5 | 6}` as const)
            : fallbackTag;

    const guaranteedHeadingClass = headingClass
        ? headingClass
        : headingTag === 'p'
          ? ('unstyled-heading' as const)
          : (`h${heading}` as const);

    const HgroupTag = headingIsMoreThanMinimum ? 'hgroup' : 'div';

    return {
        attrs: {
            heading: {
                ...attributes,
                'aria-level': heading > 6 ? heading : undefined,

                'class': makeClassList.flat(
                    [
                        headingClass,
                        html.subheading
                            ? `${guaranteedHeadingClass}--hgroup`
                            : '',
                    ],
                    classList,
                    { separator: '|' },
                ),

                'role': heading > 6 ? 'heading' : undefined,
            } satisfies ElementProps<{}, 'div'>,

            hgroup: {
                'aria-roledescription':
                    HgroupTag === 'hgroup' ? 'heading group' : null,

                ...objectOmit(attrs_hgroup ?? {}, [
                    'class',
                    'class:list' as 'class',
                ]),

                'class': makeClassList.flat(
                    `${guaranteedHeadingClass}__hgroup`,
                    attrs_hgroup?.class,
                    { separator: '|' },
                ),

                'role': HgroupTag === 'hgroup' ? 'group' : null,
            } satisfies ElementProps<{}, 'hgroup'>,

            subheading: {
                'aria-roledescription': 'subheading',

                ...objectOmit(attrs_subheading ?? {}, [
                    'class',
                    'class:list' as 'class',
                ]),

                'class': makeClassList.flat(
                    `hgroup__subheading ${guaranteedHeadingClass}__subheading`,
                    attrs_subheading?.class,
                    { separator: '|' },
                ),
            } satisfies ElementProps<{}, 'p'>,
        },

        displayHeading,
        heading,

        headingClass,
        guaranteedHeadingClass,

        headingTag,
        HeadingWrapper: headingTag,

        HgroupTag,
    } as const;
}

export function incrementHeadingLevel(
    heading: number,
    increment?: number,
): number;
export function incrementHeadingLevel(
    heading: number | undefined,
    increment?: number,
): number | undefined;
/**
 * @since 0.1.0-beta.6.draft
 */
export function incrementHeadingLevel(
    heading: number | undefined,
    increment: number = 1,
): number | undefined {
    return heading ? heading + increment : heading;
}

/* CONSTANTS ===================================== */

const html = {
    content: (await Astro.slots.render('default'))?.trim(),
    subheading: (await Astro.slots.render('subheading'))?.trim(),
};

const { attrs, HeadingWrapper, HgroupTag } = parseHeadingParams(
    html,
    Astro.props,
);
---

{
    html.content &&
        (html.subheading ? (
            <HgroupTag {...attrs.hgroup}>
                <HeadingWrapper
                    {...attrs.heading}
                    set:html={html.content}
                />
                <p
                    {...attrs.subheading}
                    set:html={html.subheading}
                />
            </HgroupTag>
        ) : (
            <HeadingWrapper
                {...attrs.heading}
                set:html={html.content}
            />
        ))
}
