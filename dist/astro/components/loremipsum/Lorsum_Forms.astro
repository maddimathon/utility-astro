---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    getLoremIpsumIds,
    LoremIpsumProps,
} from '../../functions/loremIpsum.js';

/* import - functions */

/* import - values */

/* import - components */
import Lorsum_Forms_Long from './Lorsum_Forms_Long.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export interface Props {
    components: LoremIpsumProps.Components;
    displayHeading: undefined | number;
    heading: number;
    ifDisplay: LoremIpsumProps.DisplaySettings.Parsed;
    tableOfContentsIds: ReturnType<typeof getLoremIpsumIds>;
}

const {
    components,
    displayHeading,
    heading,
    ifDisplay,
    tableOfContentsIds,
}: Props = Astro.props;

const { FormField, Heading } = components;

/* CONSTANTS ===================================== */
---

<hr />

<Heading
    displayHeading={displayHeading ?? undefined}
    heading={heading}
    id={tableOfContentsIds.form?.id}
    >Simple Form</Heading
>

<form>
    <FormField
        id='demo-form-text'
        type='text'
        name='your-name'
        placeholder='What should we call you?'
        autocomplete='off'
        ><Fragment slot='label'>Your Name</Fragment></FormField
    >

    <FormField
        id='demo-form-email'
        type='email'
        name='your-email'
        placeholder='How should we reply?'
        autocomplete='off'
        ><Fragment slot='label'>Your Email</Fragment></FormField
    >

    <FormField
        id='demo-form-textarea'
        name='your-message'
        placeholder='What would you like to tell us?'
        rows='4'
        type='textarea'
        ><Fragment slot='label'>Your Message</Fragment></FormField
    >

    <FormField
        id='demo-form-submit'
        type='submit'
        value='Send Message'
        autocomplete='off'
    />
</form>

{
    ifDisplay.formsLong && (
        <Lorsum_Forms_Long
            {...{
                components,
                disabledButtons: ifDisplay.disabledButton,
                displayHeading,
                heading,
            }}
        />
    )
}
