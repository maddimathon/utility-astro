---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type { LoremIpsumProps } from '../../functions/loremIpsum.js';

/* import - functions */

/* import - values */

/* import - components */
import Heading from '../Heading.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export interface Props {
    disabledButtons: boolean;
    displayHeading: undefined | number;
    heading: number;
    components: LoremIpsumProps.Components;
}

const {
    components: { Button, Fieldset, FormField, Select_Option },
    disabledButtons,
    displayHeading,
    heading,
}: Props = Astro.props;

/* CONSTANTS ===================================== */
---

<hr />

<Heading
    displayHeading={displayHeading ?? undefined}
    heading={heading}
    >Fancy Forms</Heading
>
<form>
    <FormField
        type='text'
        id='input1'
        name='input1'
        autocomplete='off'
    ><Fragment slot="label">Text Input</Fragment></FormField>

    <FormField
        type='tel'
        id='input2a'
        name='input2a'
        autocomplete='off'
    ><Fragment slot="label">Telephone Input</Fragment></FormField>

    <FormField
        type='tel'
        id='input2b'
        name='input2b'
        pattern='[0-9]{3}-[0-9]{2}-[0-9]{3}'
        autocomplete='off'
    ><Fragment slot="label">Telephone Input with Pattern</Fragment></FormField>

    <FormField
        type='email'
        id='input3'
        name='input3'
        autocomplete='off'
    ><Fragment slot="label">Email Input</Fragment></FormField>

    <FormField
        type='url'
        id='input4'
        name='input4'
        autocomplete='off'
    ><Fragment slot="label">URL Input</Fragment></FormField>

    <FormField
        type='password'
        id='input5'
        name='input5'
        autocomplete='off'
    ><Fragment slot="label">Password Input</Fragment></FormField>

    <FormField
        id='textarea'
        name='textarea'
        rows='5'
        type='textarea'
   ><Fragment slot="label">Textarea Element</Fragment></FormField>

    <Fieldset>
        <Fragment slot="legend">Numerical Elements</Fragment>

        <FormField
            type='number'
            id='input6'
            name='input6'
            min=''
            max=''
            step='1'
            autocomplete='off'
        ><Fragment slot="label">Number Input</Fragment></FormField>

        <FormField
            type='range'
            id='input7'
            name='input7'
            min='0'
            max='100'
            step='1'
            autocomplete='off'
        ><Fragment slot="label">Range Input</Fragment></FormField>
    </Fieldset>

    <Fieldset aria-label='Multi-Choice Elements'>
        <FormField
            type='checkbox'
            id='input8-1'
            name='input8'
            value='input8-1'
        ><Fragment slot="label">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Maiores rem labore assumenda quod?</Fragment></FormField>
        <FormField
            type='checkbox'
            id='input8-2'
            name='input8'
            value='input8-2'
        ><Fragment slot="label">Qui commodi odio, rem assumenda laboriosam quidem, nesciunt magni provident, animi autem iusto.</Fragment></FormField>
        <FormField
            type='checkbox'
            id='input8-3'
            name='input8'
            value='input8-3'
        ><Fragment slot="label">Error, delectus! Vel similique quidem nam culpa ipsum repudiandae assumenda suscipit reprehenderit nihil. Placeat labore fuga excepturi?</Fragment></FormField>
        <FormField
            type='checkbox'
            id='input8-4'
            name='input8'
            value='input8-4'
        ><Fragment slot="label">Odio atque explicabo deleniti praesentium, illo dolorem tempora.</Fragment></FormField>
        <FormField
            type='checkbox'
            id='input8-5'
            name='input8'
            value='input8-5'
        ><Fragment slot="label">Numquam veniam quod minima nisi ratione! Minima nemo aliquid eaque ducimus cupiditate cumque quibusdam a aspernatur accusantium excepturi?</Fragment></FormField>
        <FormField
            type='checkbox'
            id='input8-6'
            name='input8'
            value='input8-6'
        ><Fragment slot="label">Ab hic perferendis nesciunt asperiores animi maxime dolore. Sint dolores sed magnam ab dolorum vel eius unde labore quae autem.</Fragment></FormField>

        <FormField
            type='radio'
            id='input9-1'
            name='input9'
            value='input9-1'
        ><Fragment slot="label">Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempore fugit esse voluptates architecto asperiores rerum sed nobis nulla, sequi beatae?</Fragment></FormField>
        <FormField
            type='radio'
            id='input9-2'
            name='input9'
            value='input9-2'
        ><Fragment slot="label">Quam atque cupiditate, quia labore ut asperiores corporis perferendis vero odio ratione!</Fragment></FormField>
        <FormField
            type='radio'
            id='input9-3'
            name='input9'
            value='input9-3'
        ><Fragment slot="label">Aut doloremque ullam deleniti, obcaecati architecto maiores temporibus ipsam sapiente dolore! Eveniet dignissimos eum ex sequi sit nobis ipsa soluta minima.</Fragment></FormField>
        <FormField
            type='radio'
            id='input9-4'
            name='input9'
            value='input9-4'
        ><Fragment slot="label">Deleniti iste a distinctio exercitationem animi optio quas placeat id omnis enim, error ad corrupti necessitatibus odio.</Fragment></FormField>
        <FormField
            type='radio'
            id='input9-5'
            name='input9'
            value='input9-5'
        ><Fragment slot="label">Provident totam impedit laborum autem, accusamus perspiciatis fugiat molestiae eius commodi, ullam, assumenda rem placeat magnam ratione sequi?</Fragment></FormField>
        <FormField
            type='radio'
            id='input9-6'
            name='input9'
            value='input9-6'
        ><Fragment slot="label">Repellendus a dolorem voluptatum, fugiat quas harum nesciunt iure doloribus nostrum cumque reprehenderit iusto. Non, ipsa? Veritatis?</Fragment></FormField>

        <FormField
            class='no-label'
            id='select1'
            name='select1'
            type="select"
        >
            <Select_Option value='opt1'>Lorem, ipsum dolor.</Select_Option>
            <option value='opt2'>Tenetur, amet sunt.</option>
            <option value='opt3'>Iusto et mollitia sunt!</option>
            <option value='opt4'>Provident at consectetur quisquam?</option>
            <option value='opt5'>Aperiam, nemo.</option>
            <option value='opt6'>Ipsam iste eos suscipit.</option>
        </FormField>

        <FormField
            class='no-label'
            id='select2'
            multiple
            name='select2'
            size='3'
            type="select"
        >
            <option value='opt1'>Lorem, ipsum dolor.</option>
            <option value='opt2'>Tenetur, amet sunt.</option>
            <option value='opt3'>Iusto et mollitia sunt!</option>
            <option value='opt4'>Provident at consectetur quisquam?</option>
            <option value='opt5'>Aperiam, nemo.</option>
            <option value='opt6'>Ipsam iste eos suscipit.</option>
        </FormField>
    </Fieldset>

    <FormField
        type='date'
        id='input10'
        name='input10'
        min=''
        max=''
        autocomplete='off'
    ><Fragment slot="label">Date Input</Fragment></FormField>

    <FormField
        type='time'
        id='input11'
        name='input11'
        autocomplete='off'
    ><Fragment slot="label">Time Input</Fragment></FormField>

    <FormField
        type='datetime-local'
        id='input12'
        name='input12'
        autocomplete='off'
    ><Fragment slot="label">Datetime-Local Input</Fragment></FormField>

    <FormField
        type='week'
        id='input13'
        name='input13'
        autocomplete='off'
    ><Fragment slot="label">Week Input</Fragment></FormField>

    <FormField
        type='month'
        id='input14'
        name='input14'
        autocomplete='off'
    ><Fragment slot="label">Month Input</Fragment></FormField>

    <FormField
        type='file'
        id='input15'
        name='input15'
        autocomplete='off'
    ><Fragment slot="label">File Input</Fragment></FormField>

    <FormField
        type='color'
        id='input16'
        name='input16'
        autocomplete='off'
    ><Fragment slot="label">Colour Input</Fragment></FormField>

    <FormField
        type='hidden'
        id='input17'
        name='input17'
        value='hidden'
        autocomplete='off'
    ><Fragment slot="label">Hidden Field</Fragment></FormField>

    <FormField
        type='search'
        id='input18'
        name='input18'
        autocomplete='off'
    ><Fragment slot="label">Search Field</Fragment></FormField>

    <FormField
        type='button'
        id='button'
        name='button'
        onclick="alert('Hello!')"
        value='Say Hello!'
    ></FormField>

    <FormField
        type='reset'
        id='input20'
        name='input20'
        value='Reset Button'
    ></FormField>

    <FormField
        type='submit'
        id='input21'
        name='input21'
        value='Submit Button'
    ></FormField>

    <Button
        type='button'
        id='button2'
        name='button2'
        onclick="alert('Hello!')"
    >Say Hello!</Button>

    <Button
        type='reset'
        id='input22'
        name='input22'
    >Reset Button</Button>

    <Button
        type='submit'
        id='input23'
        name='input23'
    >Submit Button</Button>

    {disabledButtons && (
        <FormField
            type='button'
            id='button-d'
            name='button-d'
            aria-disabled='true'
            onclick="alert('Hello!')"
            value='Say Hello!'
        ></FormField>

        <FormField
            type='reset'
            id='input20-d'
            name='input20-d'
            aria-disabled='true'
            value='Reset Button'
        ></FormField>

        <FormField
            type='submit'
            id='input21-d'
            name='input21-d'
            aria-disabled='true'
            value='Submit Button'
        ></FormField>

        <Button
            type='button'
            id='button2-d'
            name='button2-d'
            aria-disabled='true'
            onclick="alert('Hello!')"
        >Say Hello!</Button>

        <Button
            type='reset'
            id='input22-d'
            name='input22-d'
            aria-disabled='true'
        >Reset Button</Button>

        <Button
            type='submit'
            id='input23-d'
            name='input23-d'
            aria-disabled='true'
        >Submit Button</Button>
    )}
</form>
