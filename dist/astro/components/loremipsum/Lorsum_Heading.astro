---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../../ts/types/index.js';

import type { HeadingProps } from '../Heading.astro';
import type { LoremIpsumProps } from '../LoremIpsum.astro';

/* import - functions */
import { makeClassList } from '../../functions.js';

/* import - values */

/* import - components */
import HeadingComponent from '../Heading.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

// prettier-ignore
export type LorsumHeadingProps = Omit<HeadingProps, 'displayHeading'> & Omit<HeadingProps, 'heading' | keyof HeadingProps> & {
    components: LoremIpsumProps.Components;

    heading: number;
    prefix?: undefined | string;
    subheading?: boolean;
};

type Props = ElementProps<LorsumHeadingProps, 'div'>;

const {
    class: classList,
    components: { Heading = HeadingComponent },
    heading,
    prefix,
    subheading = false,
    ...props
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const headingAsNum = heading <= 0 ? 100 : heading;
---

<Heading
    {...props}
    attrs={{
        hgroup: {
            class: ['loremipsum-heading-sample__hgroup'],
        },
        subheading: {
            class: ['loremipsum-heading-sample__subheading'],
        },
    }}
    class={makeClassList(
        [
            'loremipsum-heading-sample',
            subheading ? 'loremipsum-heading-sample--hgroup' : '',
        ],
        classList,
    )}
    displayHeading={heading > 0 ? heading : -1}
    heading={0}
    >{prefix ?? (heading > 0 ? `Heading ${heading}` : 'Unstyled Heading')} Maecenas
    <strong
        >Facilisis <a
            href='#'
            target='_blank'
            >Sollicitudin Nisi,</a
        ></strong
    > Eget Pellentesque qui Rhongus Condy Mongum{
        !subheading || headingAsNum > 2 ? '; Aynean Lacinya Urpa sey Lacus' : ''
    }{
        !subheading || headingAsNum > 6
            ? ' Interqum Faucibus; Donec quam Erat, Sagittis id Diam a'
            : ''
    }{
        !subheading
            ? ', Henquerit Viyerra Ligula; Proing Efficipur Rhonqus ex Augtor Faquibus; Torquent Per Conubia Nostra, Per Inceptos Himenaeos. Fusce In Arcu Ornare, Varius Ligula Eget, Myttis Sem'
            : ''
    }{
        subheading ? (
            // prettier-ignore
            <Fragment slot='subheading'>Morbi pulvinar ut <strong>arcu nec fermentum.</strong> Pellentesque at <a href='#' target='_blank'>ipsum malesuada,</a> egestas odio molestie, sollicitudin eros. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Fusce in arcu ornare, varius ligula eget, mattis sem.</Fragment>
        ) : (
            ''
        )
    }</Heading
>

<style lang='scss'>
    @forward '../../css/lorem-ipsum-heading';
</style>
