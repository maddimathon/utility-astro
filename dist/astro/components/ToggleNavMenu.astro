---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../ts/types/index.js';
import type { NavMenuProps } from './NavMenu.astro';
import type { ToggleProps } from './Toggle.astro';

/* import - functions */
import { parseMenuItem } from './NavMenu.astro';

/* import - values */

/* import - components */
import MenuList from './MenuList.astro';
import Toggle from './Toggle.astro';

/* import - layouts */

/* TYPES ===================================== */

type CombinedProps = Pick<
    NavMenuProps,
    'convertHrefStringsToAbsolute' | 'menu' | 'urlMaker'
> &
    Omit<ToggleProps, 'children' | 'displayHeading' | 'heading'>;

/**
 * Input props for the ToggleNavMenu component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export interface ToggleNavMenuProps extends CombinedProps {}

/* PROPS ===================================== */

type Props = ElementProps<ToggleNavMenuProps, 'div'>;

const {
    class: classList = [],
    convertHrefStringsToAbsolute,
    iconSVG,
    id,
    menu,
    urlMaker,
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const parsedMenu = menu.map((_item) =>
    parseMenuItem(Astro.url, _item, convertHrefStringsToAbsolute, urlMaker),
);

const buttonHTML = (await Astro.slots.render('button'))?.trim();
---

<Toggle
    {...attributes}
    {...{ iconSVG, id }}
    classBase='toggle-nav-menu'
    class:list={classList}
    role='navigation'
    tag='nav'
    type={['modal', 'nav']}
>
    <Fragment
        slot='button'
        set:text={buttonHTML || 'Menu'}
    />
    <MenuList
        id={id}
        menu={parsedMenu}
        urlMaker={urlMaker}
    />
</Toggle>
