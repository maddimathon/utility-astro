---
/**
 * Displays placeholder elements to test and display styles.
 *
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { GenericProps } from '../../ts/types/index.js';
import type { LoremIpsumProps } from '../functions/loremIpsum.js';

/* import - functions */
import {
    getLoremIpsumDisplaySettings,
    getLoremIpsumIds,
} from '../functions/loremIpsum.js';

/* import - values */

/* import - components */
import ButtonComponent from './Button.astro';
import CodeBlockComponent from './CodeBlock.astro';
import FieldsetComponent from './Fieldset.astro';
import FormFieldComponent from './FormField.astro';
import HeadingComponent from './Heading.astro';
import InputComponent from './Input.astro';
import SelectComponent from './Select.astro';
import Select_OptionComponent from './Select_Option.astro';
import TableComponent from './Table.astro';
import TextareaComponent from './Textarea.astro';
import ToggleComponent from './Toggle.astro';

import Lorsum_Content_Abbreviated from './loremipsum/Lorsum_Content_Abbreviated.astro';
import Lorsum_Content_Full from './loremipsum/Lorsum_Content_Full.astro';
import Lorsum_Disclaimer from './loremipsum/Lorsum_Disclaimer.astro';
import Lorsum_Forms from './loremipsum/Lorsum_Forms.astro';
import Lorsum_Lists from './loremipsum/Lorsum_Lists.astro';
import Lorsum_Table from './loremipsum/Lorsum_Table.astro';
import Lorsum_Toggle from './loremipsum/Lorsum_Toggle.astro';

/* import - layouts */

/* EXPORTS ===================================== */

export * from '../functions/loremIpsum.js';

/* TYPES ===================================== */

export type LoremIpsumComponentType = (props: LoremIpsumProps) => any

/* PROPS ===================================== */

type Props = GenericProps<LoremIpsumProps>;

const {
    // abbreviated = false,
    asSection = true,
    components = {},
    superAbbreviated = false,
    toggleProps = {},
    previewComponents = {},
    ...props
}: Props = Astro.props;

/* FUNCTIONS ===================================== */

/* CONSTANTS ===================================== */

const ifDisplay = getLoremIpsumDisplaySettings(props);

const tableOfContentsIds = getLoremIpsumIds(props, ifDisplay);

const displayHeading = props.displayHeading ?? props.heading;

const heading = props.heading ?? 2;

const disclaimerHTML = (await Astro.slots.render('disclaimer'))?.trim();

const fullProps = {
    components: {
        Button: components.Button ?? ButtonComponent,
        CodeBlock: components.CodeBlock ?? CodeBlockComponent,
        Fieldset: components.Fieldset ?? FieldsetComponent,
        FormField: components.FormField ?? FormFieldComponent,
        Heading: components.Heading ?? HeadingComponent,
        Input: components.Input ?? InputComponent,
        Textarea: components.Textarea ?? TextareaComponent,
        Select: components.Select ?? SelectComponent,
        Select_Option: components.Select_Option ?? Select_OptionComponent,
        Table: components.Table ?? TableComponent,
        Toggle: components.Toggle ?? ToggleComponent,
    },

    displayHeading,
    heading,
    ifDisplay,

    previewComponents: {
        Forms: previewComponents.Forms ?? Lorsum_Forms,
        Lists: previewComponents.Lists ?? Lorsum_Lists,
        Table: previewComponents.Table ?? Lorsum_Table,
        Toggle: previewComponents.Toggle ?? Lorsum_Toggle,
    },
    
    props,
    tableOfContentsIds,
    toggleProps,
} satisfies ComponentProps<typeof Lorsum_Content_Full>;

const Lorsum_Content = superAbbreviated ? Lorsum_Content_Abbreviated :Lorsum_Content_Full;
---

{
    asSection ? (
        <section
            class='display-contents'
            aria-label='Visual styles preview'
        >
            <Lorsum_Disclaimer
                {...{ disclaimerHTML, displayHeading, heading }}
            />
            <Lorsum_Content {...fullProps}>
                <slot />
                <slot
                    slot='two'
                    name='two'
                />
                <slot
                    slot='three'
                    name='three'
                />
                <slot
                    slot='four'
                    name='four'
                />
            </Lorsum_Content>
        </section>
    ) : (
    <Lorsum_Disclaimer {...{ disclaimerHTML, displayHeading, heading }} />
        <Lorsum_Content {...fullProps}>
            <slot />
            <slot
                slot='two'
                name='two'
            />
            <slot
                slot='three'
                name='three'
            />
            <slot
                slot='four'
                name='four'
            />
        </Lorsum_Content>
    )
}

<style lang='scss'>
    @forward '../css/lorem-ipsum';
</style>
