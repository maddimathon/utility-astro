---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { ElementProps } from '../../ts/types/index.js';

/* import - functions */
import { absoluteInternalURL } from '../functions.js';
import { mapToObject } from '../../ts/index.js';

/* import - values */
import { SVG } from '../../ts/svg.js';

/* import - components */
import Toggle_Control from '../support/Toggle_Control.astro';

import ButtonComponent from './Button.astro';
import FieldsetComponent from './Fieldset.astro';
import InputComponent from './Input.astro';
import RenderedSlotContent from './RenderedSlotContent.astro';
import SelectComponent from './Select.astro';
import SettingsMenu_Option from './SettingsMenu_Option.astro';
import TextareaComponent from './Textarea.astro';

/* import - layouts */

/* TYPES ===================================== */

/**
 * Input props for the SettingsMenu component.
 *
 * @since 0.1.0-alpha
 * @since 0.1.0-alpha.17 — Moved to component file.
 */
export interface SettingsMenuProps {
    /**
     * Email used for a focus link to report accessibility issues.
     */
    accessibilityReportEmail?: string | undefined;

    /**
     * @since 0.1.0-beta.3
     */
    components?:
        | undefined
        | Partial<ComponentProps<typeof SettingsMenu_Option>['components']>;

    /**
     * @since 0.1.0-beta.0
     */
    iconSVG?: string;

    /**
     * Unique id attr.
     */
    id?: string | undefined;

    /**
     * A complete URL to the privacy policy page for this site.
     */
    privacyPolicy?: URL | string | undefined;

    /**
     * Whether to each settings group.
     */
    settings?: {
        /**
         * @default true
         */
        brightness?: boolean | undefined;

        /**
         * @default false
         */
        contrast?:
            | boolean
            | {
                  /**
                   * Whether to include the max contrast option.
                   *
                   * @default false
                   */
                  max?: boolean | undefined;
              }
            | undefined;

        /**
         * @default false
         */
        motion?: boolean | undefined;

        /**
         * Custom settings options to append to the defaults.
         */
        custom?:
            | {
                  /**
                   * Unique id value for this setting -- also used to set the associated data attribute.
                   */
                  id: string;

                  /**
                   * The display name for this setting in the menu.
                   */
                  label: string;

                  /**
                   * Default value.
                   */
                  default: string;

                  /**
                   * All options, including the default.
                   */
                  options: {
                      label: string;
                      value: string;

                      labelClass?: string | undefined;
                  }[];
              }[]
            | undefined;
    };
}

/* PROPS ===================================== */

type Props = ElementProps<SettingsMenuProps, 'div'>;

const {
    accessibilityReportEmail,

    class: classList = ['website-settings'],
    components: inputComponents = {},
    iconSVG: iconSVG_input,
    id = 'website-settings',

    privacyPolicy: privacyPolicyURL,
    settings: inputSettings,

    ...attributes
}: Props = Astro.props;

const components = {
    Button: inputComponents.Button ?? ButtonComponent,
    Fieldset: inputComponents.Fieldset ?? FieldsetComponent,
    Input: inputComponents.Input ?? InputComponent,
    Select: inputComponents.Select ?? SelectComponent,
    Textarea: inputComponents.Textarea ?? TextareaComponent,
} satisfies ComponentProps<typeof SettingsMenu_Option>['components'];

const { Button, Fieldset } = components;

/* FUNCTIONS ===================================== */

/* CONSTANTS ===================================== */

const buttonID = `${id}-button`;
const contentID = `${id}-content`;

const accessEmailSubject =
    'Accessibility Issue — ' +
    absoluteInternalURL(
        Astro.url,
        decodeURI(Astro.url.pathname),
        false,
    ).replace(/^https?:\/\/(www\.)?/gi, '');

const settings: Required<Required<SettingsMenuProps>['settings']> = {
    brightness: true,
    contrast: false,
    motion: false,

    custom: [],

    ...inputSettings,
};

/**
 * Rendered slot HTML.
 */
const slots_render = mapToObject(
    await Promise.all(
        (['default', 'settingsMenuOpen', 'settingsMenuClose'] as const).map(
            async (_key) => {
                const _kebab = _key.replace(
                    /([a-z0-9])([A-Z])/g,
                    (_v, _cap1, _cap2) => _cap1 + '-' + _cap2.toLowerCase(),
                );

                return [
                    _key,
                    Astro.slots.has(_kebab) &&
                        (await Astro.slots.render(_kebab))?.trim(),
                ] as const;
            },
        ),
    ),
);

const iconSVG =
    iconSVG_input ??
    '<span class="icon icon--settings | toggle-block__control__icon website-settings__control__icon website-settings__control__icon--fallback">' +
        SVG.settings.trim() +
        '</span>';
---

<section
    id={id}
    class:list={classList}
    aria-label='Accessibility & Display Settings'
    {...attributes}
    data-settings-menu
    data-settings-path={absoluteInternalURL(Astro.url, '')}
    data-toggle-container
    data-toggle-container-type='menu'
>
    <RenderedSlotContent
        name='settings-menu'
        html={slots_render.default}
    />
    <Toggle_Control
        {...{ id, buttonID, iconSVG }}
        aria-label='Toggle settings menu'
        classBase='website-settings'
        data-toggle-primary-control={id}
        includeDefaultBase={false}
        title='Accessibility & Display Settings'
    />

    <form
        aria-label='Settings menu'
        class='website-settings__content'
        data-toggle-content={id}
        id={contentID}
    >
        <div class='container'>
            <RenderedSlotContent
                name='settings-menu-open'
                html={slots_render.settingsMenuOpen}
            />
            {
                accessibilityReportEmail && (
                    <p class='website-settings__report'>
                        <a
                            href={`mailto:${accessibilityReportEmail}?subject=${encodeURIComponent(accessEmailSubject)}`}
                        >
                            Report Accessibility Issue
                        </a>
                    </p>
                )
            }
            {
                settings.brightness && (
                    <Fieldset tabindex='-1'>
                        <Fragment slot='legend'>Brightness Mode</Fragment>
                        <div class='container'>
                            <SettingsMenu_Option
                                components={components}
                                name='brightness-mode'
                                label='Light'
                                value='light'
                            />
                            <SettingsMenu_Option
                                components={components}
                                name='brightness-mode'
                                label='Dark'
                                value='dark'
                            />
                        </div>
                    </Fieldset>
                )
            }
            {
                settings.contrast && (
                    <Fieldset tabindex='-1'>
                        <Fragment slot='legend'>Contrast Mode</Fragment>
                        <div class='container'>
                            <SettingsMenu_Option
                                components={components}
                                name='contrast-mode'
                                label='Low'
                                value='low'
                            />
                            <SettingsMenu_Option
                                components={components}
                                name='contrast-mode'
                                label='Average'
                                value='average'
                            />
                            <SettingsMenu_Option
                                components={components}
                                name='contrast-mode'
                                label='High'
                                value='high'
                            />
                            {typeof settings.contrast === 'object' &&
                                settings.contrast.max && (
                                    <SettingsMenu_Option
                                        components={components}
                                        name='contrast-mode'
                                        label='Maximum'
                                        value='max'
                                    />
                                )}
                            <SettingsMenu_Option
                                class='forced-colors-mode-only'
                                components={components}
                                name='contrast-mode'
                                label='Custom'
                                value='forced-colors'
                            />
                        </div>

                        <p class='forced-colors-mode-only aside'>
                            Your browser or computer has a ‘forced colours’ or
                            custom contrast mode enabled, so changing the
                            contrast setting will have little impact (if any).
                        </p>
                    </Fieldset>
                )
            }
            {
                settings.motion && (
                    <Fieldset tabindex='-1'>
                        <Fragment slot='legend'>Motion/Animation</Fragment>
                        <div class='container'>
                            <SettingsMenu_Option
                                components={components}
                                name='motion'
                                label='Default'
                                value='no-preference'
                            />
                            <SettingsMenu_Option
                                components={components}
                                name='motion'
                                label='Reduce'
                                value='reduce'
                            />
                        </div>
                    </Fieldset>
                )
            }
            {
                settings.custom &&
                    settings.custom.map(
                        (setting) =>
                            setting.options.length && (
                                <Fieldset
                                    data-settings-menu-custom-setting={
                                        setting.id
                                    }
                                    data-settings-menu-custom-setting-default={
                                        setting.default
                                    }
                                    tabindex='-1'
                                >
                                    <Fragment
                                        slot='legend'
                                        set:text={setting.label}
                                    />

                                    <div class='container'>
                                        {setting.options.map((opt) => (
                                            <SettingsMenu_Option
                                                class={opt.labelClass}
                                                components={components}
                                                name={setting.id}
                                                label={opt.label}
                                                value={opt.value}
                                            />
                                        ))}
                                    </div>
                                </Fieldset>
                            ),
                    )
            }

            <Button
                data-settings-reset
                type='reset'
                >Reset Settings</Button
            >

            <RenderedSlotContent
                name='settings-menu-close'
                html={slots_render.settingsMenuClose}
            />
        </div>
    </form>

    <div
        data-toggle-control={id}
        data-toggle-control-backdrop={id}
        class='toggle-block__control--backdrop website-settings__control--backdrop'
        aria-hidden='true'
    >
    </div>
</section>

<style lang='scss'>
    @forward '../css/forced-colors-mode-only';
</style>

<script src='../scripts/toggle.ts'></script>
<script src='../scripts/settings-menu.ts'></script>
