 * @since 0.1.0-beta.0.draft
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '../../ts/types/index.js';

/* import - functions */
import { flattenClassList, makeClassList } from '../functions.js';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export interface ToggleBackdropProps {
    /**
     * Add an additional base class to use.
     */
    classBase?: string | undefined;

    toggleID: string;
}

type Props = ElementProps<ToggleBackdropProps, 'div'>;

const {
    class: classList = [],
    classBase,
    toggleID,
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const classMaker = classBase
    ? (append: string = '') =>
          'toggle-block' + append + ' ' + classBase + append
    : (append: string = '') => 'toggle-block' + append;
---

<div
    {...attributes}
    data-toggle-control={toggleID}
    data-toggle-control-backdrop={toggleID}
    class={flattenClassList(
        makeClassList(classList, classMaker('__control--backdrop')),
    )}
    aria-hidden='true'
>
</div>
