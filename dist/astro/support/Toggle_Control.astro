---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    ButtonComponentType,
    GenericButtonElementProps,
} from '../components/Button.astro';

/* import - functions */
import { makeClassList } from '../functions.js';

/* import - values */

/* import - components */
import ButtonComponent from '../components/Button.astro';
import RenderedSlotContent from '../components/RenderedSlotContent.astro';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export type ToggleControlProps = GenericButtonElementProps<
    {
        id: string;
        buttonID: string;

        /**
         * Add an additional base class to use.
         */
        classBase?: string | undefined;

        components: {
            Button: ButtonComponentType;
        };

        includeDefaultBase?: boolean;

        icon?: boolean;
        iconSVG?: undefined | string;
    },
    'button'
>;

type Props = ToggleControlProps;

export type ToggleControlComponentType = (props: ToggleControlProps) => any;

const {
    buttonID,
    class: classList = [],
    classBase,
    components: { Button = ButtonComponent },
    id,
    includeDefaultBase = true,

    icon = true,

    iconSVG,

    ...attrs
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const buttonHTML = (await Astro.slots.render('default'))?.trim();

export const DEFAULT_TOGGLE_ICON = `<span class='icon icon--toggle | toggle-block__control__icon toggle-block__control__icon--fallback'>
    <svg
        aria-ignore='true'
        role='img'
        width='100%'
        height='100%'
        viewBox='0 0 24 24'
        version='1.1'
        xmlns='http://www.w3.org/2000/svg'
        xmlns:xlink='http://www.w3.org/1999/xlink'
        xml:space='preserve'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'
    >
        <path
            id='a'
            d='M5 12h14'
        />
        <path
            id='b'
            d='M12 5v14'
        />
    </svg>
</span>`;

const classMaker = classBase
    ? includeDefaultBase
        ? (append: string = '') =>
              'toggle-block' + append + ' ' + classBase + append
        : (append: string = '') => classBase + append
    : (append: string = '') => 'toggle-block' + append;
---

<Button
    {...attrs}
    aria-disabled='true'
    class={makeClassList.flat(classMaker('__control'), classList, {
        separator: '|',
    })}
    data-toggle-control={id}
    id={buttonID}
    type='button'
>
    {icon && <Fragment set:html={iconSVG ?? DEFAULT_TOGGLE_ICON} />}
    <slot name='before' />
    {
        (!attrs['aria-label'] || buttonHTML) && (
            <span class={classMaker('__control__inner')}>
                <RenderedSlotContent
                    html={buttonHTML}
                    name='button'
                >
                    <Fragment
                        slot='empty-before'
                        set:text={'Toggle me'}
                    />
                </RenderedSlotContent>
            </span>
        )
    }
    <slot name='after' />
</Button>

<style lang='scss'>
    @forward '../css/icon';
</style>
